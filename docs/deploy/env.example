# /etc/zangqu/api.env
#
# 部署时执行：
#   sudo mkdir -p /etc/zangqu
#   sudo cp env.example /etc/zangqu/api.env
#   sudo vim /etc/zangqu/api.env          # 填真实值
#   sudo chown root:www-data /etc/zangqu/api.env
#   sudo chmod 640 /etc/zangqu/api.env
#   sudo systemctl restart zangqu-api
#
# 🔴 这个文件**绝对不能进仓库**，也不能提交 git。
#    填好后确认：git check-ignore -v /etc/zangqu/api.env 之外，
#    仓库里只应有本模板（全为空值）。

# ─── 基础 ─────────────────────────────────────
PORT=3000
DB_PATH=/opt/zangqu/server/orders.db
MAX_BODY_BYTES=1048576

# ─── 微信小程序（AppID 可公开，AppSecret 绝不能外传）──
WX_APPID=wx3378038122ee9d54
WX_APPSECRET=

# ─── 虚拟支付 ─────────────────────────────────
# 环境：0 = 沙箱/测试，1 = 正式（需与 mp 后台一致）
WX_ENV=0

# OfferID：mp 后台 → 虚拟支付 → 基本配置 → OfferID（可公开，会随下单请求发出）
WX_OFFER_ID=

# AppKey：mp 后台 → 虚拟支付 → 基本配置 → AppKey（**密钥，泄露即可被伪造下单**）
WX_APPKEY_SANDBOX=
WX_APPKEY_PROD=

# ─── 遥测接口鉴权（R10：/telemetry/read 必须鉴权）──
# 生成方式：openssl rand -hex 32
TELEMETRY_TOKEN=
