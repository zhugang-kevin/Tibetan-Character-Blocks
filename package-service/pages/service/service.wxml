<!-- package-service/pages/service/service.wxml — 帮助与客服（三合一窗口，D167）
     三件事：① 反馈问题 ② 唐卡商品 ③ 高端定制留言
     全部走**微信客服会话**，不依赖自建服务器；页面在分包里，不占主包预算。 -->
<view class="page">
  <view class="scenery" aria-hidden="true">
    <view class="sv-pattern"></view>
    <view class="sv-night"></view>
  </view>

  <view class="content">
    <view class="sv-hero">
      <view class="sv-title">帮助与客服</view>
      <view class="sv-sub">「{{game}}」——有问题、想买东西、想要更好的，都在这里</view>
    </view>

    <!-- 切换 -->
    <view class="sv-tabs">
      <view wx:for="{{tabs}}" wx:key="key"
            class="sv-tab {{active === item.key ? 'sv-tab-on' : ''}}"
            data-key="{{item.key}}" bindtap="onTab">{{item.name}}</view>
    </view>

    <!-- ① 反馈问题 -->
    <block wx:if="{{active === 'feedback'}}">
      <view class="sv-card">
        <view class="sv-card-title">遇到问题了？</view>
        <view class="sv-card-note">点下面的按钮直接进客服会话，把截图或描述发过来。我们会回。</view>
        <block wx:if="{{serviceEnabled}}">
          <button class="sv-btn" open-type="contact" session-from="feedback"
                  aria-label="联系客服反馈问题">联系客服 · 反馈问题</button>
        </block>
        <!-- Q18：未开通就明说，不给点了没反应的假按钮 -->
        <view wx:else class="sv-card-note">{{serviceNote}}</view>
      </view>
      <view class="sv-card">
        <view class="sv-card-title">常见问题</view>
        <view class="sv-faq" wx:for="{{faq}}" wx:key="q">
          <view class="sv-q">{{item.q}}</view>
          <view class="sv-a">{{item.a}}</view>
        </view>
      </view>
    </block>

    <!-- ② 虚拟礼物（D177：走虚拟支付，不挂实物） -->
    <block wx:if="{{active === 'gift'}}">
      <view class="sv-card">
        <view class="sv-card-title">虚拟礼物</view>
        <view class="sv-card-note">{{giftNote}}</view>
      </view>
      <view wx:for="{{gifts}}" wx:key="id" class="sv-card sv-goods">
        <view class="sv-goods-name">{{item.name}}</view>
        <view class="sv-goods-meta">{{item.note}}</view>
        <view class="sv-goods-row">
          <view class="sv-price">¥{{item.price}}</view>
          <button class="sv-btn sv-btn-sm" bindtap="onGoGift" aria-label="去送{{item.name}}">去送</button>
        </view>
      </view>
      <view class="sv-card">
        <button class="sv-btn" bindtap="onGoGift" aria-label="打开收礼页">打开收礼页</button>
        <view class="sv-card-note" style="margin-top:16rpx">{{giftTip}}</view>
      </view>
    </block>

    <!-- ③ 联系我们 -->
    <block wx:if="{{active === 'contact'}}">
      <view class="sv-card">
        <view class="sv-card-title">找我们</view>
        <view class="sv-card-note">{{contactNote}}</view>
        <block wx:if="{{serviceEnabled}}">
          <button class="sv-btn" open-type="contact" session-from="contact"
                  aria-label="联系客服">进入客服会话</button>
        </block>
        <!-- Q18：同上，未开通时只显示说明 -->
        <view wx:else class="sv-card-note">{{serviceNote}}</view>
      </view>
      <view class="sv-card">
        <view class="sv-card-title">回复时间</view>
        <view class="sv-list">
          <view class="sv-li">· 工作日 9:00–21:00，一般 2 小时内回</view>
          <view class="sv-li">· 夜间留言次日上午回</view>
          <view class="sv-li">· 只说问题的机型与关卡编号，能最快定位</view>
        </view>
      </view>
    </block>

    <view class="sv-foot">{{disclaimer}}</view>
  </view>
</view>
