<!-- package-service/pages/service/service.wxml — 帮助与客服（三合一窗口，D167）
     三件事：① 反馈问题 ② 唐卡商品 ③ 高端定制留言
     全部走**微信客服会话**，不依赖自建服务器；页面在分包里，不占主包预算。 -->
<view class="page">
  <view class="scenery" aria-hidden="true">
    <view class="sv-pattern"></view>
    <view class="sv-night"></view>
  </view>

  <view class="content">
    <view class="sv-hero">
      <view class="sv-title">帮助与客服</view>
      <view class="sv-sub">「{{game}}」——有问题、想买东西、想要更好的，都在这里</view>
    </view>

    <!-- 切换 -->
    <view class="sv-tabs">
      <view wx:for="{{tabs}}" wx:key="key"
            class="sv-tab {{active === item.key ? 'sv-tab-on' : ''}}"
            data-key="{{item.key}}" bindtap="onTab">{{item.name}}</view>
    </view>

    <!-- ① 反馈问题 -->
    <block wx:if="{{active === 'feedback'}}">
      <view class="sv-card">
        <view class="sv-card-title">遇到问题了？</view>
        <view class="sv-card-note">点下面的按钮直接进客服会话，把截图或描述发过来。我们会回。</view>
        <button class="sv-btn" open-type="contact" session-from="feedback"
                aria-label="联系客服反馈问题">联系客服 · 反馈问题</button>
      </view>
      <view class="sv-card">
        <view class="sv-card-title">常见问题</view>
        <view class="sv-faq" wx:for="{{faq}}" wx:key="q">
          <view class="sv-q">{{item.q}}</view>
          <view class="sv-a">{{item.a}}</view>
        </view>
      </view>
    </block>

    <!-- ② 唐卡商品 -->
    <block wx:if="{{active === 'thangka'}}">
      <view class="sv-card">
        <view class="sv-card-title">唐卡</view>
        <view class="sv-card-note">{{thangkaNote}}</view>
      </view>
      <view wx:for="{{thangkas}}" wx:key="id" class="sv-card sv-goods">
        <view class="sv-goods-name">{{item.name}}</view>
        <view class="sv-goods-meta">{{item.size}} · {{item.craft}}</view>
        <view class="sv-goods-row">
          <view class="sv-price">¥{{item.price}}</view>
          <button class="sv-btn sv-btn-sm" open-type="contact" session-from="thangka-{{item.id}}"
                  aria-label="咨询这件唐卡">咨询/购买</button>
        </view>
      </view>
      <view class="sv-card">
        <view class="sv-card-note">看不清细节想要大图、或者想指定题材与尺寸，点这里跟客服说。</view>
        <button class="sv-btn" open-type="contact" session-from="thangka-custom"
                aria-label="咨询唐卡定制">告诉客服我想要什么</button>
      </view>
    </block>

    <!-- ③ 高端定制留言 -->
    <block wx:if="{{active === 'bespoke'}}">
      <view class="sv-card">
        <view class="sv-card-title">想要更好的</view>
        <view class="sv-card-note">{{bespokeNote}}</view>
        <button class="sv-btn" open-type="contact" session-from="bespoke"
                aria-label="留言咨询高端定制">留言给客服</button>
      </view>
      <view class="sv-card">
        <view class="sv-card-title">留言请带上这几点</view>
        <view class="sv-list">
          <view class="sv-li">· 题材（例如绿度母、白度母、药师佛）</view>
          <view class="sv-li">· 尺寸（例如 60×90cm，或按墙面尺寸）</view>
          <view class="sv-li">· 预算区间</view>
          <view class="sv-li">· 期望到手时间</view>
        </view>
        <view class="sv-card-note">带齐这四点，客服能一次给你准信，不用来回问。</view>
      </view>
    </block>

    <view class="sv-foot">{{disclaimer}}</view>
  </view>
</view>
