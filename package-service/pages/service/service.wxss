/* package-service/pages/service/service.wxss — 帮助与客服（D167）
   与 pages/shop 同一套暖红底 + 米色卡片的比例，保持视觉一致。 */

.page { position: relative; min-height: 100vh; background: #6E1A18; overflow: hidden; }

.scenery { position: absolute; left: 0; right: 0; top: 0; height: 100%; pointer-events: none; }
.sv-pattern {
  position: absolute; left: 0; right: 0; top: 0; height: 420rpx;
  background: linear-gradient(180deg, rgba(192, 57, 43, .55), rgba(110, 26, 24, 0));
}
.sv-night {
  position: absolute; left: 0; right: 0; bottom: 0; height: 300rpx;
  background: linear-gradient(180deg, rgba(60, 12, 11, 0), rgba(60, 12, 11, .55));
}

.content { position: relative; padding: 48rpx 32rpx 64rpx; }

.sv-hero { margin-bottom: 28rpx; }
.sv-title { font-size: 46rpx; font-weight: 700; color: #F6DCA0; letter-spacing: 2rpx; }
.sv-sub { margin-top: 12rpx; font-size: 26rpx; color: #E7B98A; line-height: 1.6; }

.sv-tabs { display: flex; gap: 12rpx; margin-bottom: 28rpx; }
.sv-tab {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx;
  font-size: 26rpx; color: #E7B98A; background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(246, 220, 160, .28);
}
.sv-tab-on { background: #F6DCA0; color: #6E1A18; font-weight: 700; border-color: #F6DCA0; }

.sv-card {
  background: #FDF6E3; border-radius: 18rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 6rpx 20rpx rgba(60, 12, 11, .18);
}
.sv-card-title { font-size: 30rpx; font-weight: 700; color: #8C2A22; margin-bottom: 12rpx; }
.sv-card-note { font-size: 26rpx; color: #6B5A4A; line-height: 1.7; }

.sv-btn {
  margin-top: 20rpx; background: #B3201A; color: #FFF3DC;
  font-size: 28rpx; font-weight: 600; border-radius: 12rpx; padding: 20rpx 0;
  border: none; line-height: 1.2;
}
.sv-btn::after { border: none; }
.sv-btn-sm { margin-top: 0; padding: 14rpx 28rpx; font-size: 26rpx; }

.sv-faq { padding-top: 4rpx; border-top: 1rpx solid rgba(140, 42, 34, .12); margin-top: 16rpx; }
.sv-faq:first-of-type { border-top: none; margin-top: 0; padding-top: 0; }
.sv-q { font-size: 26rpx; color: #3A2A1E; font-weight: 600; margin-top: 16rpx; }
.sv-a { font-size: 26rpx; color: #6B5A4A; line-height: 1.7; margin-top: 6rpx; }

.sv-goods-name { font-size: 30rpx; font-weight: 700; color: #3A2A1E; }
.sv-goods-meta { font-size: 26rpx; color: #8A7663; margin-top: 8rpx; }
.sv-goods-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.sv-price { font-size: 34rpx; font-weight: 700; color: #B3201A; }

.sv-list { margin-top: 8rpx; }
.sv-li { font-size: 26rpx; color: #3A2A1E; line-height: 1.9; }

.sv-foot { margin-top: 16rpx; font-size: 26rpx; color: rgba(246, 220, 160, .62); line-height: 1.7; }
.sv-icp { margin-top: 4rpx; font-size: 26rpx; color: rgba(246, 220, 160, .45); }

/* 三档分组的标题条（D171） */
.sv-tier {
  margin: 28rpx 0 12rpx; padding-left: 16rpx;
  font-size: 26rpx; font-weight: 700; color: #F6DCA0;
  border-left: 6rpx solid #F6DCA0; line-height: 1.2;
}
