/* ============ 万家灯火 · 祈福跳窗（每天首次打开一次，纯本地无请求） ============ */
.lamp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  /* 暗金 + 深红 + 青金石蓝：暗金光晕底图之上的夜色罩 */
  background:
    radial-gradient(circle at 50% 26%, rgba(241, 196, 15, 0.22) 0%, rgba(241, 196, 15, 0) 46%),
    linear-gradient(180deg, rgba(74, 21, 21, 0.86) 0%, rgba(11, 30, 54, 0.94) 100%);
}
.lamp-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  max-height: 88vh;
  overflow: hidden;
  padding: 0;
  /* 三段式：可滚动中部 + 固定底栏。此前整卡 overflow:hidden 且无滚动，
     内容一超高 CTA / 关闭出口就被裁出屏幕（375×667 实测按钮只露半截）。 */
  display: flex;
  flex-direction: column;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(46, 26, 18, 0.94) 0%, rgba(22, 20, 40, 0.94) 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.75);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.55), inset 0 2rpx 0 rgba(255, 233, 168, 0.35);
}

/* 中部滚动区：内容再长也不裁切。D53：顶部 padding 归零——佛龛层要通铺到卡片边，
   由 .lamp-shrine 的负外边距抵消左右 padding。 */
.lamp-scroll {
  flex: 1 1 auto;
  min-height: 0;
  padding: 0 34rpx 6rpx;
}

/* 固定底栏：CTA 与关闭按钮永远在屏幕内（类名避开酥油灯座 .lamp-foot，D35 撞名教训） */
.lamp-actions {
  flex: 0 0 auto;
  padding: 10rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(212, 175, 55, 0.28);
  background: linear-gradient(180deg, rgba(22, 20, 40, 0.2), rgba(22, 20, 40, 0.75));
}

/* 右上角关闭（任何状态都可用） */
.lamp-x {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  z-index: 3;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #E8D9A8;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid rgba(212, 175, 55, 0.45);
}

/* 点亮后的显著关闭按钮 */
.lamp-close {
  margin-top: 18rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFF6DC;
  background: linear-gradient(180deg, #C0392B 0%, #8E2A20 100%);
  box-shadow: 0 10rpx 22rpx rgba(140, 32, 24, 0.5), inset 0 3rpx 0 rgba(255, 255, 255, 0.28);
}
.lamp-halo {
  position: absolute;
  left: 50%;
  top: 0;               /* D53：移入佛龛层后以龛顶为基准（原 -22% 会画出滚动区外被裁） */
  width: 120%;
  height: 40%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 226, 140, 0.5) 0%, rgba(241, 196, 15, 0.16) 44%, transparent 74%);
  pointer-events: none;
}
/* D53：标题 / 主数字 / 副行全部改为佛龛层内的绝对定位（此前是文档流）。
   定位基准 = 佛龛层高度（= 底图高 = 1.268 × 卡宽），百分比随屏宽等比缩放。 */
.lamp-title {
  position: absolute;
  top: 7%;
  left: 0; right: 0;
  z-index: 2;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #FFE9A8;
  text-shadow: 0 3rpx 14rpx rgba(241, 196, 15, 0.5);
}
.lamp-sub {
  position: absolute;
  top: 93%;
  left: 0; right: 0;
  z-index: 2;
  text-align: center;
  font-size: 26rpx;
  color: #EBD9B4;
}

/* 主数字：万/亿口径（12.85万）。精确值移到灯座下方的句子里（128,457 盏灯）。
   两者共用同一套墨色（#FFD98A / #EBD9B4），不引入新墨，避免触碰 §30 白名单。
   D53 位置规则（用户点名）：**主数字横穿灯腰**——灯的上半部（碗口+火焰）在数字
   之上，下半部（灯座）在数字之下。灯体占位：底 8% / 高 212rpx ⇒ 顶 ≈65%、
   腰 ≈77%（shrine ≈786rpx @620 卡宽）；数字行高 76rpx、top 70% ⇒ 行中心 ≈74.8%，
   正落在灯腰上（§44.4 机械校核，偏出灯腰 ±4% 直接红）。 */
.lamp-total {
  position: absolute;
  top: 70%;
  left: 0; right: 0;
  z-index: 2;
  text-align: center;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFD98A;
  text-shadow: 0 3rpx 16rpx rgba(241, 196, 15, 0.45);
}
.lamp-unit { margin-left: 8rpx; font-size: 26rpx; font-weight: 400; color: #C9BFA8; }

/* 点亮瞬间的跳动：主数字与精确副行同时弹一下。
   万/亿口径在 +1 时通常不变，真正在跳的是副行里的 128,456 → 128,457。 */
.lamp-total.pop, .lamp-sub.pop {
  animation: lampPop 620ms cubic-bezier(0.22, 1.2, 0.36, 1) both;
}
@keyframes lampPop {
  0% { transform: scale(1); }
  34% { transform: scale(1.16); }
  100% { transform: scale(1); }
}

/* 各地灯火的辉光点：等级由行号循环决定（3,1,4,2,3），与数量无关，纯装饰。
   相位由 animation-delay 错开，像远近不同的灯各自呼吸，不构成高低或位次。 */
.lamp-l { display: flex; align-items: center; gap: 12rpx; }
.lamp-gl {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFD98A;
  animation: lampGlow 2.8s ease-in-out infinite;
}
.glow-1 { opacity: 0.34; box-shadow: 0 0 5rpx rgba(255, 217, 138, 0.42); }
.glow-2 { opacity: 0.52; box-shadow: 0 0 8rpx rgba(255, 217, 138, 0.54); }
.glow-3 { opacity: 0.72; box-shadow: 0 0 12rpx rgba(255, 217, 138, 0.66); }
.glow-4 { opacity: 0.92; box-shadow: 0 0 17rpx rgba(255, 217, 138, 0.82); }
@keyframes lampGlow {
  0%, 100% { transform: scale(0.86); }
  50% { transform: scale(1.12); }
}

/* ---- D50 灯火跳窗改版：释迦牟尼底图 + 色罩（装饰层，不参与交互） ----
   D53 佛龛层：底图 / 色罩 / 光晕 / 酥油灯 / 标题 / 主数字 收进同一个
   position:relative 容器，几何全部用「佛龛层高度的百分比」表达——
   佛龛层高 = 底图高 = 1.268 × 卡宽（widthFix 等比），因此所有比例随屏宽等比缩放，
   灯座与佛陀座基的共线关系不随机型漂移。 */
.lamp-shrine {
  position: relative;
  /* 抵消 .lamp-scroll 的左右 padding，底图通铺到卡片边 */
  margin: 0 -34rpx;
}
.lamp-buddha {
  display: block;          /* 消除 inline 图片基线空隙（高度会多出几 px） */
  width: 100%;             /* mode=widthFix：高 = 宽 × 786/620 ≈ 1.268 × 卡宽 */
}
.lamp-veil {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  /* 第二层夜色罩：压住照片艳部，保证金字与正文可读（图内已烘一层，这里只做轻罩） */
  background: linear-gradient(180deg, rgba(11, 30, 54, 0.38) 0%, rgba(74, 21, 21, 0.30) 100%);
  pointer-events: none;
}
.lamp-scroll, .lamp-actions { position: relative; z-index: 2; }

/* ---- D50 鎏金酥油灯（真实图片）+ 写实火苗 ----
   未点亮（无 .lit）：火苗、光晕完全静止（用户要求：点灯之前火焰是静态的）。
   点亮后（.lit）：外焰/焰芯/光晕三层各自异相动画，焰形由 SVG 渐变渲染的
   flame.webp 提供（橙缘 + 白黄焰芯 + 淡蓝焰根），transform 全部走 keyframes，
   定位用 left:calc(50% - Nrpx) 避开 transform 冲突。
   D53 几何（全部相对佛龛层）：
   · 灯体缩到 50%（用户口径「缩小 70%」二选一后拍板 50%）：300×424 → 150×212rpx
   · 灯座 bottom:8% ↔ 底图 92% 处的座基（供桌线），契约见 make_lamp_assets.py
   · 火苗 / 光晕 / 金粉按 0.5 等比缩小，锚点跟随灯座（calc(% + rpx) 混合定位） */
.lamp-flame {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 1;
  pointer-events: none;
}
.lamp-img {
  position: absolute;
  /* 灯足在抠图 bbox 里偏右（质心实测 0.578 宽）→ 左移 12rpx 让灯柱回到中轴 */
  left: calc(50% - 87rpx);
  bottom: 8%;
  width: 150rpx;
  height: 212rpx;
}
.flame-halo {
  position: absolute;
  left: calc(50% - 65rpx);
  bottom: calc(8% + 138rpx);
  width: 130rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 206, 84, 0.28) 0%, rgba(241, 196, 15, 0.08) 48%, transparent 76%);
}
.flame-img {
  position: absolute;
  width: 46rpx;
  height: 80rpx;
}
.fi-outer {
  left: calc(50% - 23rpx);
  bottom: calc(8% + 165rpx);
  transform-origin: 50% 96%;
}
.fi-core {
  left: calc(50% - 14rpx);
  bottom: calc(8% + 171rpx);
  width: 28rpx;
  height: 49rpx;
  opacity: 0.92;
  transform-origin: 50% 96%;
}
/* 点亮后：三层异相火焰（周期互质，避免「整齐划一」的机械感） */
.lit .fi-outer { animation: flameSway 1.7s ease-in-out infinite; }
.lit .fi-core { animation: flameDance 1.13s ease-in-out infinite; }
.lit .flame-halo { animation: haloBreathe 2.3s ease-in-out infinite; }
@keyframes flameSway {
  0%, 100% { transform: scale(1, 1) skewX(0deg); }
  28% { transform: scale(0.94, 1.08) skewX(2.4deg); }
  55% { transform: scale(1.04, 0.94) skewX(-1.8deg); }
  78% { transform: scale(0.97, 1.04) skewX(1.2deg); }
}
@keyframes flameDance {
  0%, 100% { transform: scale(1, 1) skewX(0deg); }
  36% { transform: scale(1.1, 0.9) skewX(-2.6deg); }
  64% { transform: scale(0.9, 1.12) skewX(2.2deg); }
}
@keyframes haloBreathe {
  0%, 100% { opacity: 0.55; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1.06); }
}

/* 点亮后的金粉爆炸粒子（12 向；D53 随灯体等比缩到 0.5） */
.sparks { position: absolute; left: 50%; bottom: calc(8% + 178rpx); width: 0; height: 0; }
.spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFF6D0 0%, #F1C40F 58%, rgba(241, 196, 15, 0) 100%);
  animation: sparkFly 0.9s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}
.spark:nth-child(1) { --dx: 0rpx; --dy: -110rpx; }
.spark:nth-child(2) { --dx: 55rpx; --dy: -95rpx; }
.spark:nth-child(3) { --dx: 95rpx; --dy: -55rpx; }
.spark:nth-child(4) { --dx: 110rpx; --dy: 0rpx; }
.spark:nth-child(5) { --dx: 95rpx; --dy: 55rpx; }
.spark:nth-child(6) { --dx: 55rpx; --dy: 95rpx; }
.spark:nth-child(7) { --dx: 0rpx; --dy: 110rpx; }
.spark:nth-child(8) { --dx: -55rpx; --dy: 95rpx; }
.spark:nth-child(9) { --dx: -95rpx; --dy: 55rpx; }
.spark:nth-child(10) { --dx: -110rpx; --dy: 0rpx; }
.spark:nth-child(11) { --dx: -95rpx; --dy: -55rpx; }
.spark:nth-child(12) { --dx: -55rpx; --dy: -95rpx; }
@keyframes sparkFly {
  0% { transform: translate(0, 0) scale(0.4); opacity: 1; }
  70% { opacity: 0.9; }
  100% { transform: translate(var(--dx), var(--dy)) scale(1.1); opacity: 0; }
}

/* 灯火列表 / 莲花 / 按钮 */
.lamp-sec {
  position: relative;
  margin-top: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #C9BFA8;
}
.lamp-list { margin-top: 10rpx; }
.lamp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.22);
}
.lamp-p { font-size: 26rpx; color: #F0E6D2; }
.lamp-c { font-size: 26rpx; font-weight: 700; color: #FFD98A; }
.lamp-home {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #EBD9B4;
  background: rgba(36, 113, 163, 0.22);
  border: 1rpx solid rgba(36, 113, 163, 0.45);
}
.lamp-lotus { display: flex; gap: 18rpx; margin-top: 10rpx; }
.lotus-cell {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(212, 175, 55, 0.32);
}
.lotus-ico { font-size: 34rpx; display: block; }
.lotus-k { display: block; margin-top: 6rpx; font-size: 22rpx; color: #C9BFA8; }
.lotus-v { display: block; margin-top: 4rpx; font-size: 28rpx; font-weight: 700; color: #FFD98A; }
.lotus-cell.pink .lotus-v { color: #F2B6C6; }
.lamp-btn {
  margin-top: 26rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #3D2E05;
  background: linear-gradient(180deg, #FFE9A8 0%, #F1C40F 46%, #B7950B 100%);
  box-shadow: 0 12rpx 26rpx rgba(181, 137, 0, 0.45), inset 0 3rpx 0 rgba(255, 255, 255, 0.6);
}
/* D50（用户点名文案）：点亮后的第一按钮——致谢（点击同为收下灯火，不留死按钮） */
.lamp-thanks {
  margin-top: 26rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #3D2E05;
  background: linear-gradient(180deg, #FFE9A8 0%, #F1C40F 46%, #B7950B 100%);
  box-shadow: 0 12rpx 26rpx rgba(181, 137, 0, 0.45), inset 0 3rpx 0 rgba(255, 255, 255, 0.6);
}
.lamp-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FFE9A8;
  text-shadow: 0 2rpx 10rpx rgba(241, 196, 15, 0.45);
}
.lamp-skip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6E6759;
}
.lamp-note {
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6E6759;
}
