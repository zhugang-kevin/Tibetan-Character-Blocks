/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #451510 0%, #2E1220 26%, #101F38 62%, #0B1E36 100%);
}

/* ============ 藏文化背景层 ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-bg {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.16;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.14;
}

/* 夜色罩：压暗四角、突出中心金光，保证前景可读（禁止大白板） */
.sc-night {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 32%,
    rgba(255, 214, 140, 0.08) 0%,
    rgba(16, 22, 42, 0.42) 46%,
    rgba(5, 8, 18, 0.8) 100%);
}

/* Hero：紧凑品牌行（对标消消乐——首页视觉重心是藤蔓地图，品牌只占顶部一行） */
.hero {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 6rpx 0 30rpx;
}

.hero-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(192, 57, 43, 0.3);
}

.hero-txt {
  text-align: left;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #F5E9CF;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.55);
}

.hero-slogan {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #FFC96B;
}

.level-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.level-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 36rpx 0;
  border-radius: 20rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #E4DCC8;
  background: #FFFFFF;
}

.level-item.open {
  background: #FFFFFF;
  border-color: #C0392B;
  box-shadow: 0 6rpx 18rpx rgba(192, 57, 43, 0.15);
}

.level-item.done {
  background: #F0F9F0;
  border-color: #1E8449;
}

.level-item.locked {
  background: #F3EFE3;
  border-color: #DDD5C2;
  opacity: 0.75;
}

.level-num {
  font-size: 34rpx;
  font-weight: 600;
}

.locked .level-num {
  color: #A79F8D;
}

.done .level-num {
  color: #1E8449;
}

.open .level-num {
  color: #C0392B;
}

.level-state {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.state-done { color: #1E8449; }
.state-open { color: #C0392B; }
.state-locked { color: #A79F8D; }

.footer {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C9BFA8;
}

.footer-tagline {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  color: #E8C86B;
}

/* 品牌规范：文字主色用深灰 #2C3E50，不用纯黑 */
page,
.page {
  color: #2C3E50;
}

/* 我的档案：印记 + 连击 */
.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.profile-stamps {
  display: flex;
  gap: 12rpx;
}

.mini-stamp {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border: 3rpx solid #C0392B;
  border-radius: 14rpx;
  color: #C0392B;
  font-size: 26rpx;
  font-weight: 700;
  background: #FDF6E3;
  transform: rotate(-4deg);
}

.profile-combo {
  font-size: 26rpx;
  font-weight: 700;
  color: #B7950B;
  background: #FFFFFF;
  border: 2rpx solid #E4DCC8;
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
}

/* 文化护照入口 */
.passport-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 26rpx;
  border-radius: 22rpx;
  border: 3rpx solid #1E8449;
  background: linear-gradient(135deg, #FFFFFF 0%, #F1F8F1 100%);
  box-shadow: 0 10rpx 26rpx rgba(30, 132, 73, 0.16);
}

.pc-left {
  flex: 1;
  min-width: 0;
}

.pc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E8449;
}

.pc-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B6455;
}

.pc-right {
  text-align: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.pc-count {
  font-size: 44rpx;
  font-weight: 700;
  color: #C0392B;
  line-height: 1;
}

.pc-total {
  font-size: 24rpx;
  color: #A79F8D;
  font-weight: 600;
}

.pc-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A8375;
}

/* 阶段标题（关卡网格上方） */
.stage-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.stage-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFD98A;
}

.stage-range {
  font-size: 22rpx;
  color: #B9AE94;
}

/* 权益中心入口（双轨制到店权益） */
.benefit-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 26rpx;
  border-radius: 22rpx;
  border: 3rpx solid #B7950B;
  background: linear-gradient(135deg, #FFFFFF 0%, #FCF6E4 100%);
  box-shadow: 0 10rpx 26rpx rgba(96, 78, 44, 0.12);
}

.bc-left {
  flex: 1;
  min-width: 0;
}

.bc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #B7950B;
}

.bc-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B6455;
}

.bc-right {
  text-align: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.bc-arrow {
  font-size: 44rpx;
  font-weight: 700;
  color: #B7950B;
  line-height: 1;
}

.bc-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A8375;
}

/* ============ PRD v4 首页：资源条 / 藤蔓地图 / 悬浮入口 / 底部平层 / 入口面板 ============ */
.page { padding-bottom: 190rpx; }

/* 顶部资源条（灯油 / 积分 / 唐卡碎片） */
.res-bar {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.res-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(214, 202, 176, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(96, 78, 44, 0.12);
}
.res-ico { font-size: 28rpx; }
.res-val { font-size: 28rpx; font-weight: 700; color: #C0392B; }
.res-cap { font-size: 20rpx; color: #8A8375; }

/* 朝圣天梯地图：山脚（人间）→ 石阶 → 山顶（天堂） */
.vine-map {
  position: relative;
  z-index: 1;
  height: 1180rpx;
  margin: 18rpx 0 8rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: linear-gradient(180deg,
    rgba(255, 214, 120, 0.42) 0%,
    rgba(255, 240, 205, 0.30) 16%,
    rgba(250, 240, 218, 0.34) 42%,
    rgba(122, 108, 138, 0.26) 76%,
    rgba(38, 32, 58, 0.52) 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.55);
}

/* 石阶中轴：灰白石阶引路 + 金色描边中线 */
.vine-stem {
  position: absolute;
  left: 50%;
  top: 13%;
  bottom: 7%;
  width: 22rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: linear-gradient(90deg, #B9BEC4 0%, #E4E7EA 30%, #D5D8DC 55%, #8E979E 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.65);
  box-shadow: inset 4rpx 0 8rpx rgba(255, 255, 255, 0.6), 0 6rpx 16rpx rgba(60, 66, 72, 0.3);
}
.vine-stem::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 6rpx;
  transform: translateX(-50%);
  background-image: linear-gradient(180deg, #D4AF37 0 18rpx, transparent 18rpx 40rpx);
  background-size: 6rpx 40rpx;
  background-repeat: repeat-y;
  opacity: 0.8;
}

/* 天堂层：金色佛光 + 祥云 + 布达拉宫金顶剪影 + 坛城光环 */
.ladder-heaven {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 15%;
  pointer-events: none;
}
.h-glow {
  position: absolute;
  left: 50%;
  top: -46%;
  width: 88%;
  height: 150%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 226, 140, 0.85) 0%, rgba(241, 196, 15, 0.38) 42%, transparent 72%);
}
.h-mandala {
  position: absolute;
  left: 50%;
  top: 6%;
  width: 200rpx;
  height: 200rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 3rpx solid rgba(212, 175, 55, 0.5);
  box-shadow: 0 0 0 16rpx rgba(212, 175, 55, 0.14), 0 0 0 34rpx rgba(212, 175, 55, 0.08);
}
.h-potala {
  position: absolute;
  left: 50%;
  top: 26%;
  width: 240rpx;
  height: 96rpx;
  transform: translateX(-50%);
  background: linear-gradient(180deg, #F1C40F 0%, #B7950B 78%, #8A6A12 100%);
  clip-path: polygon(4% 100%, 4% 66%, 20% 66%, 20% 42%, 36% 42%, 36% 22%, 50% 4%, 64% 22%, 64% 42%, 80% 42%, 80% 66%, 96% 66%, 96% 100%);
  filter: drop-shadow(0 4rpx 10rpx rgba(122, 90, 0, 0.4));
  opacity: 0.92;
}
.h-cloud {
  position: absolute;
  width: 150rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFF7DF 0%, #FFE9A8 100%);
  opacity: 0.85;
  filter: blur(1rpx);
}
.h-cloud::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: -20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: inherit;
}
.h-cloud::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: -14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: inherit;
}
.hc-l { left: 6%; top: 40%; }
.hc-r { right: 6%; top: 52%; transform: scale(0.82); }

/* 山脚村落剪影（人间起点） */
.ladder-village {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 10%;
  background: #221B33;
  clip-path: polygon(0% 100%, 0% 62%, 7% 62%, 7% 40%, 13% 30%, 19% 40%, 19% 58%, 27% 58%, 27% 34%, 33% 34%, 33% 18%, 38% 10%, 43% 18%, 43% 34%, 50% 34%, 50% 56%, 58% 56%, 58% 38%, 64% 38%, 64% 24%, 70% 24%, 70% 44%, 78% 44%, 78% 62%, 86% 62%, 86% 46%, 91% 36%, 96% 46%, 96% 100%);
  opacity: 0.62;
  pointer-events: none;
}

/* 五色经幡：蓝白红绿黄，两侧竖挂 */
.ladder-flags {
  position: absolute;
  top: 18%;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  pointer-events: none;
  opacity: 0.9;
}
.fl-left { left: 10rpx; height: 34%; }
.fl-right { right: 10rpx; top: 34%; height: 34%; }
.ladder-flags .flag {
  width: 16rpx;
  flex: 1;
  border-radius: 0 4rpx 4rpx 0;
  opacity: 0.72;
}
.fl-left .flag { border-radius: 0 4rpx 4rpx 0; }
.fl-right .flag { border-radius: 4rpx 0 0 4rpx; }
.ladder-flags .flag:nth-child(5n + 1) { background: #2471A3; }
.ladder-flags .flag:nth-child(5n + 2) { background: #F6F1E4; }
.ladder-flags .flag:nth-child(5n + 3) { background: #C0392B; }
.ladder-flags .flag:nth-child(5n + 4) { background: #1E8449; }
.ladder-flags .flag:nth-child(5n + 5) { background: #B7950B; }

/* 关卡节点（天梯上的石阶：一级台阶一个节点） */
.level-item.node {
  position: absolute;
  width: 128rpx;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: none;
  border: none;
  padding: 0;
}
.node-deco {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: -4rpx;
  filter: drop-shadow(0 0 8rpx rgba(241, 196, 15, 0.85));
}
.node-badge {
  width: 112rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B12;
  /* 藏式石阶：灰白石板 + 金色描边 + 顶部高光 */
  background: linear-gradient(180deg, #E8EBEE 0%, #D5D8DC 46%, #A9B2B9 100%);
  border: 3rpx solid #D4AF37;
  box-shadow: 0 6rpx 14rpx rgba(50, 56, 62, 0.35), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75), inset 0 -6rpx 10rpx rgba(127, 140, 141, 0.45);
}
.level-item.open .node-badge {
  /* 当前可玩：金色发光石阶（呼吸动效） */
  background: linear-gradient(180deg, #F7DE8B 0%, #F1C40F 44%, #B7950B 100%);
  border-color: #FFE9A8;
  color: #3D2E05;
  animation: nodePulse 1.8s ease-in-out infinite;
}
.level-item.done .node-badge {
  /* 已通关：石阶 + 莲花灯光晕 */
  border-color: #D4AF37;
  box-shadow: 0 6rpx 16rpx rgba(241, 196, 15, 0.4), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75), inset 0 -6rpx 10rpx rgba(127, 140, 141, 0.45);
}
.level-item.locked .node-badge {
  /* 未解锁：灰暗石阶 + 藏式锁 */
  background: linear-gradient(180deg, #B4AFA5 0%, #9A9384 50%, #7F8C8D 100%);
  border-color: rgba(127, 140, 141, 0.7);
  color: #F0EBDD;
}
@keyframes nodePulse {
  0%, 100% { box-shadow: 0 6rpx 14rpx rgba(50, 56, 62, 0.35), 0 0 10rpx rgba(241, 196, 15, 0.35), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.7); }
  50% { box-shadow: 0 8rpx 22rpx rgba(181, 137, 0, 0.5), 0 0 30rpx rgba(241, 196, 15, 0.65), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.85); }
}

.node-stars { display: flex; gap: 2rpx; }
.node-stars .star { font-size: 22rpx; line-height: 1; color: #DDD3BC; }
.node-stars .star.on { color: #F1C40F; text-shadow: 0 1rpx 2rpx rgba(120, 90, 0, 0.4); }

/* ============ 天梯动效（入场升起 / 台阶错峰 / 莲花绽放 / 点击回弹） ============ */

/* 入场：整条天梯自山脚升起（位移 + 轻微放大，模拟「向上攀爬」的第一眼） */
.vine-map.in {
  animation: ladderRise 1.05s cubic-bezier(0.2, 0.82, 0.24, 1) both;
}
@keyframes ladderRise {
  0% { opacity: 0; transform: translateY(80rpx) scale(0.986); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 台阶依次浮现（延迟由 WXML 内联 animation-delay 给出，形成自下而上的节奏） */
.vine-map.in .level-item.node {
  animation: nodeRise 0.66s cubic-bezier(0.24, 0.86, 0.28, 1) both;
}
@keyframes nodeRise {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.66); }
  100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

/* 点击回弹：按住时台阶轻微下沉（消消乐式手感，与 hover-class 配合） */
.level-item.node { transition: transform 0.14s ease-out; }
.level-item.node.node-press { transform: translate(-50%, -50%) scale(0.92); }

/* 通关瞬间：台阶上莲花绽放 + 金色光环保开 */
.node-bloom {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46rpx;
  height: 46rpx;
  margin: -23rpx 0 0 -23rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(241, 196, 15, 0.9);
  box-shadow: 0 0 20rpx rgba(241, 196, 15, 0.55);
  pointer-events: none;
  animation: bloomRing 1.15s cubic-bezier(0.16, 0.84, 0.3, 1) both;
}
@keyframes bloomRing {
  0% { transform: scale(0.34); opacity: 0.95; }
  100% { transform: scale(3.8); opacity: 0; }
}
.node-deco.pop {
  animation: lotusBloom 1.2s cubic-bezier(0.2, 0.9, 0.28, 1) both;
}
@keyframes lotusBloom {
  0% { transform: scale(0.2) translateY(12rpx); opacity: 0; filter: drop-shadow(0 0 0 rgba(241, 196, 15, 0)); }
  46% { transform: scale(1.5) translateY(-6rpx); opacity: 1; }
  72% { transform: scale(0.94) translateY(0); }
  100% { transform: scale(1) translateY(0); opacity: 1; filter: drop-shadow(0 0 14rpx rgba(241, 196, 15, 0.9)); }
}

/* 地区剪影：未解锁灰色，解锁后点亮 */
.region {
  position: absolute;
  left: 0;
  right: 0;
  height: 130rpx;
  display: flex;
  align-items: center;
  padding-left: 18rpx;
  transform: translateY(-50%);
  pointer-events: none;
}
.region-shape {
  width: 150rpx;
  height: 92rpx;
  opacity: 0.5;
  background-repeat: no-repeat;
  background-size: contain;
}
.region.dim .region-shape { filter: grayscale(1) brightness(1.16); opacity: 0.34; }
.region.lit .region-shape { filter: none; opacity: 0.72; }
.region-txt { margin-left: 14rpx; display: flex; flex-direction: column; }
.region-name { font-size: 24rpx; font-weight: 700; color: #6B6455; }
.region.dim .region-name { color: #A9A192; }
.region-spot { font-size: 20rpx; color: #9A9384; }

/* 五地剪影造型（简笔线条感，用 CSS 形状表达） */
.region-shape.potala {
  background: linear-gradient(180deg, #B7950B 0%, #8A6A12 100%);
  clip-path: polygon(6% 100%, 6% 62%, 22% 62%, 22% 40%, 38% 40%, 38% 20%, 50% 8%, 62% 20%, 62% 40%, 78% 40%, 78% 62%, 94% 62%, 94% 100%);
}
.region-shape.forest { background: #1E8449; clip-path: polygon(0% 100%, 16% 46%, 30% 74%, 44% 30%, 58% 70%, 72% 40%, 88% 78%, 100% 100%); }
.region-shape.valley { background: #2471A3; clip-path: polygon(0% 100%, 0% 62%, 26% 30%, 50% 58%, 74% 26%, 100% 58%, 100% 100%); }
.region-shape.monastery { background: #C0392B; clip-path: polygon(4% 100%, 4% 58%, 20% 58%, 20% 34%, 50% 12%, 80% 34%, 80% 58%, 96% 58%, 96% 100%); }
.region-shape.snow { background: #5D6D7E; clip-path: polygon(0% 100%, 30% 22%, 44% 52%, 58% 10%, 72% 48%, 100% 100%); }

/* 左右悬浮入口 */
.side-rail {
  position: fixed;
  top: 56%;
  z-index: 6;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.side-rail.left { left: 10rpx; }
.side-rail.right { right: 10rpx; top: 60%; }
.side-btn {
  position: relative;
  width: 96rpx;
  padding: 12rpx 6rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(214, 202, 176, 0.95);
  box-shadow: 0 6rpx 16rpx rgba(96, 78, 44, 0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.side-ico { font-size: 32rpx; line-height: 1; }
.side-txt { font-size: 18rpx; color: #6B6455; }
.side-dot {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 18rpx;
  text-align: center;
  line-height: 30rpx;
}

/* 底部大平层 */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 7;
  display: flex;
  justify-content: space-around;
  gap: 8rpx;
  padding: 14rpx 12rpx calc(14rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(253, 246, 227, 0.94), rgba(242, 228, 198, 0.98));
  border-top: 1rpx solid rgba(214, 202, 176, 0.95);
  box-shadow: 0 -8rpx 22rpx rgba(96, 78, 44, 0.14);
}
.dock-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.dock-ico { font-size: 34rpx; }
.dock-txt { font-size: 20rpx; color: #6B6455; }

/* 入口面板（统一底部滑出，非阻塞） */
.entry-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 8;
  max-height: 74vh;
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  transform: translateY(112%);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-shadow: 0 -12rpx 40rpx rgba(60, 44, 16, 0.28);
  overflow: hidden;
}
.entry-panel.show { transform: translateY(0); }
.entry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx 12rpx;
  border-bottom: 1rpx solid rgba(214, 202, 176, 0.7);
}
.entry-title { font-size: 32rpx; font-weight: 700; color: #2C3E50; }
.entry-x { font-size: 28rpx; color: #8A8375; padding: 0 8rpx; }
.entry-body { max-height: 58vh; padding: 20rpx 26rpx; }
.entry-foot {
  padding: 12rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  font-size: 20rpx;
  color: #9A9384;
  text-align: center;
  border-top: 1rpx solid rgba(214, 202, 176, 0.7);
}
.entry-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.entry-metric {
  flex: 1 1 46%;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FBF6E8;
  border: 1rpx solid rgba(214, 202, 176, 0.8);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.em-v { font-size: 38rpx; font-weight: 700; color: #C0392B; }
.em-k { font-size: 22rpx; color: #8A8375; }
.entry-note { margin-top: 16rpx; font-size: 22rpx; color: #8A8375; line-height: 1.7; }
.entry-btn {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: linear-gradient(180deg, #C0392B, #96291D);
  color: #FFF6DC;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 0 #6E1D14;
}
.entry-btn.off { background: linear-gradient(180deg, #B9B1A0, #8A8375); box-shadow: 0 6rpx 0 #6B6455; }

/* 长明灯 */
.lamp-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.lamp-ring { flex: 1 1 28%; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.lamp-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F2EDE0;
  color: #9A9384;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(214, 202, 176, 0.9);
}
.lamp-dot.on {
  background: radial-gradient(circle at 50% 38%, #FFE9A8 0%, #F1C40F 52%, #B7950B 100%);
  color: #6B4B00;
  border-color: rgba(183, 149, 11, 0.9);
  box-shadow: 0 0 18rpx rgba(241, 196, 15, 0.6);
}
.lamp-label { font-size: 18rpx; color: #8A8375; text-align: center; }

/* 雪域日签 */
.daily-tib { font-size: 56rpx; color: #C0392B; text-align: center; line-height: 1.5; }
.daily-roman { margin-top: 8rpx; text-align: center; font-size: 24rpx; color: #8A8375; }
.daily-cn { margin-top: 12rpx; text-align: center; font-size: 32rpx; font-weight: 700; color: #2C3E50; }

/* 唐卡拼图样式已上移 app.wxss（首页面板与文化护照「唐卡收藏」板块共用，2026-10-05） */

/* 非遗盲盒 */
.box-open {
  padding: 26rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #2471A3, #1B4F72);
  box-shadow: 0 8rpx 20rpx rgba(36, 113, 163, 0.32);
}
.box-text { margin-top: 18rpx; padding: 20rpx; border-radius: 16rpx; background: #FBF6E8; font-size: 26rpx; color: #4A4438; line-height: 1.7; }

/* 道具铺 */
.shop-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(214, 202, 176, 0.6);
}
.shop-ico { font-size: 40rpx; }
.shop-main { flex: 1; }
.shop-name { font-size: 28rpx; font-weight: 700; color: #2C3E50; }
.shop-count { font-size: 20rpx; color: #8A8375; font-weight: 400; }
.shop-desc { margin-top: 6rpx; font-size: 22rpx; color: #8A8375; }
.shop-btn {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #B7950B, #8A6A12);
  color: #FFF6DC;
  font-size: 22rpx;
  font-weight: 700;
}

/* 排行榜（本地成绩单） */
.rank-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(214, 202, 176, 0.6);
}
.rank-k { font-size: 26rpx; color: #6B6455; }
.rank-v { font-size: 30rpx; font-weight: 700; color: #C0392B; }

/* 菩提树 / 冬游 */
.tree-art { font-size: 120rpx; text-align: center; }
.winter-card { padding: 18rpx 0; border-bottom: 1rpx solid rgba(214, 202, 176, 0.6); }
.wc-title { font-size: 28rpx; font-weight: 700; color: #2C3E50; }
.wc-text { margin-top: 8rpx; font-size: 24rpx; color: #6B6455; line-height: 1.7; }

/* ============ 万家灯火 · 祈福跳窗（每天首次打开一次，纯本地无请求） ============ */
.lamp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  /* 暗金 + 深红 + 青金石蓝：暗金光晕底图之上的夜色罩 */
  background:
    radial-gradient(circle at 50% 26%, rgba(241, 196, 15, 0.22) 0%, rgba(241, 196, 15, 0) 46%),
    linear-gradient(180deg, rgba(74, 21, 21, 0.86) 0%, rgba(11, 30, 54, 0.94) 100%);
}
.lamp-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  max-height: 88vh;
  overflow: hidden;
  padding: 44rpx 34rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(46, 26, 18, 0.94) 0%, rgba(22, 20, 40, 0.94) 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.75);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.55), inset 0 2rpx 0 rgba(255, 233, 168, 0.35);
}
.lamp-halo {
  position: absolute;
  left: 50%;
  top: -22%;
  width: 120%;
  height: 62%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 226, 140, 0.5) 0%, rgba(241, 196, 15, 0.16) 44%, transparent 74%);
  pointer-events: none;
}
.lamp-title {
  position: relative;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #FFE9A8;
  text-shadow: 0 3rpx 14rpx rgba(241, 196, 15, 0.5);
}
.lamp-sub {
  position: relative;
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #EBD9B4;
}

/* 3D 酥油灯 + CSS 火焰 */
.lamp-flame {
  position: relative;
  height: 210rpx;
  margin: 26rpx 0 8rpx;
}
.flame-glow {
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 260rpx;
  height: 200rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 206, 84, 0.55) 0%, rgba(241, 196, 15, 0.14) 48%, transparent 76%);
  animation: lampBreathe 2.6s ease-in-out infinite;
}
.flame {
  position: absolute;
  left: 50%;
  border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%;
  transform-origin: 50% 100%;
}
.flame.f1 {
  bottom: 92rpx;
  width: 46rpx;
  height: 96rpx;
  margin-left: -23rpx;
  background: linear-gradient(180deg, #FFF3C4 0%, #FFC24B 52%, #E9711F 100%);
  box-shadow: 0 0 26rpx rgba(255, 176, 46, 0.75);
  animation: flicker 1.5s ease-in-out infinite;
}
.flame.f2 {
  bottom: 96rpx;
  width: 26rpx;
  height: 60rpx;
  margin-left: -13rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFE9A8 60%, #FFB43C 100%);
  opacity: 0.92;
  animation: flicker 1.1s ease-in-out infinite reverse;
}
.flame.f3 {
  bottom: 90rpx;
  width: 76rpx;
  height: 40rpx;
  margin-left: -38rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 196, 70, 0.55) 0%, transparent 70%);
  animation: lampBreathe 2.2s ease-in-out infinite;
}
@keyframes flicker {
  0%, 100% { transform: scaleY(1) scaleX(1) translateY(0); }
  32% { transform: scaleY(1.14) scaleX(0.94) translateY(-4rpx); }
  66% { transform: scaleY(0.92) scaleX(1.05) translateY(2rpx); }
}
@keyframes lampBreathe {
  0%, 100% { opacity: 0.72; }
  50% { opacity: 1; }
}

/* 酥油灯碗（3D：碗身 + 碗口高光 + 底座） */
.lamp-body {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 220rpx;
  height: 92rpx;
  transform: translateX(-50%);
}
.lamp-cup {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 62rpx;
  border-radius: 0 0 50% 50% / 0 0 78% 78%;
  background: linear-gradient(180deg, #F2CE5C 0%, #C9971B 52%, #7E5C10 100%);
  box-shadow: inset 0 8rpx 12rpx rgba(255, 245, 200, 0.6), 0 10rpx 20rpx rgba(0, 0, 0, 0.42);
}
.lamp-cup::after {
  content: '';
  position: absolute;
  left: 14rpx; right: 14rpx; top: 6rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 236, 168, 0.85), rgba(255, 200, 90, 0.1));
}
.lamp-foot {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 130rpx;
  height: 40rpx;
  transform: translateX(-50%);
  border-radius: 0 0 26rpx 26rpx;
  background: linear-gradient(180deg, #C9971B 0%, #6E5010 100%);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.4);
}

/* 点亮后的金粉爆炸粒子（12 向） */
.sparks { position: absolute; left: 50%; bottom: 150rpx; width: 0; height: 0; }
.spark {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFF6D0 0%, #F1C40F 58%, rgba(241, 196, 15, 0) 100%);
  animation: sparkFly 0.9s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}
.spark:nth-child(1) { --dx: 0rpx; --dy: -220rpx; }
.spark:nth-child(2) { --dx: 110rpx; --dy: -190rpx; }
.spark:nth-child(3) { --dx: 190rpx; --dy: -110rpx; }
.spark:nth-child(4) { --dx: 220rpx; --dy: 0rpx; }
.spark:nth-child(5) { --dx: 190rpx; --dy: 110rpx; }
.spark:nth-child(6) { --dx: 110rpx; --dy: 190rpx; }
.spark:nth-child(7) { --dx: 0rpx; --dy: 220rpx; }
.spark:nth-child(8) { --dx: -110rpx; --dy: 190rpx; }
.spark:nth-child(9) { --dx: -190rpx; --dy: 110rpx; }
.spark:nth-child(10) { --dx: -220rpx; --dy: 0rpx; }
.spark:nth-child(11) { --dx: -190rpx; --dy: -110rpx; }
.spark:nth-child(12) { --dx: -110rpx; --dy: -190rpx; }
@keyframes sparkFly {
  0% { transform: translate(0, 0) scale(0.4); opacity: 1; }
  70% { opacity: 0.9; }
  100% { transform: translate(var(--dx), var(--dy)) scale(1.1); opacity: 0; }
}

/* 灯火列表 / 莲花 / 按钮 */
.lamp-sec {
  position: relative;
  margin-top: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #C9BFA8;
}
.lamp-list { margin-top: 10rpx; }
.lamp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.22);
}
.lamp-p { font-size: 26rpx; color: #F0E6D2; }
.lamp-c { font-size: 26rpx; font-weight: 700; color: #FFD98A; }
.lamp-home {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #EBD9B4;
