/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  padding: 30rpx 0 50rpx;
}

.hero-logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 44rpx;
  box-shadow: 0 10rpx 30rpx rgba(192, 57, 43, 0.3);
}

.hero-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #2C3E50;
}

.hero-slogan {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #C0392B;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin: 20rpx auto 0;
  max-width: 560rpx;
  font-size: 26rpx;
  color: #8A8375;
  line-height: 1.6;
}

.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.level-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 36rpx 0;
  border-radius: 20rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #E4DCC8;
  background: #FFFFFF;
}

.level-item.open {
  background: #FFFFFF;
  border-color: #C0392B;
  box-shadow: 0 6rpx 18rpx rgba(192, 57, 43, 0.15);
}

.level-item.done {
  background: #F0F9F0;
  border-color: #1E8449;
}

.level-item.locked {
  background: #F3EFE3;
  border-color: #DDD5C2;
  opacity: 0.75;
}

.level-num {
  font-size: 34rpx;
  font-weight: 600;
}

.locked .level-num {
  color: #A79F8D;
}

.done .level-num {
  color: #1E8449;
}

.open .level-num {
  color: #C0392B;
}

.level-state {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.state-done { color: #1E8449; }
.state-open { color: #C0392B; }
.state-locked { color: #A79F8D; }

.footer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A79F8D;
}

.footer-tagline {
  font-size: 26rpx;
  font-weight: 600;
  color: #B7950B;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

/* 品牌规范：文字主色用深灰 #2C3E50，不用纯黑 */
page,
.page {
  color: #2C3E50;
}
