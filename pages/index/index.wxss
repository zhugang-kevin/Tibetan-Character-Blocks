/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #FDF6E3 0%, #FAF0DA 52%, #F2E4C6 100%);
}

/* ============ 藏文化背景层 ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.88;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.95;
}

.hero {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 30rpx 0 50rpx;
}

.hero-logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 44rpx;
  box-shadow: 0 10rpx 30rpx rgba(192, 57, 43, 0.3);
}

.hero-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #2C3E50;
}

.hero-slogan {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #C0392B;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin: 20rpx auto 0;
  max-width: 560rpx;
  font-size: 26rpx;
  color: #8A8375;
  line-height: 1.6;
}

.level-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.level-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 36rpx 0;
  border-radius: 20rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #E4DCC8;
  background: #FFFFFF;
}

.level-item.open {
  background: #FFFFFF;
  border-color: #C0392B;
  box-shadow: 0 6rpx 18rpx rgba(192, 57, 43, 0.15);
}

.level-item.done {
  background: #F0F9F0;
  border-color: #1E8449;
}

.level-item.locked {
  background: #F3EFE3;
  border-color: #DDD5C2;
  opacity: 0.75;
}

.level-num {
  font-size: 34rpx;
  font-weight: 600;
}

.locked .level-num {
  color: #A79F8D;
}

.done .level-num {
  color: #1E8449;
}

.open .level-num {
  color: #C0392B;
}

.level-state {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.state-done { color: #1E8449; }
.state-open { color: #C0392B; }
.state-locked { color: #A79F8D; }

.footer {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A79F8D;
}

.footer-tagline {
  font-size: 26rpx;
  font-weight: 600;
  color: #B7950B;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

/* 品牌规范：文字主色用深灰 #2C3E50，不用纯黑 */
page,
.page {
  color: #2C3E50;
}

/* 我的档案：印记 + 连击 */
.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.profile-stamps {
  display: flex;
  gap: 12rpx;
}

.mini-stamp {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border: 3rpx solid #C0392B;
  border-radius: 14rpx;
  color: #C0392B;
  font-size: 26rpx;
  font-weight: 700;
  background: #FDF6E3;
  transform: rotate(-4deg);
}

.profile-combo {
  font-size: 26rpx;
  font-weight: 700;
  color: #B7950B;
  background: #FFFFFF;
  border: 2rpx solid #E4DCC8;
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
}

/* 文化护照入口 */
.passport-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 26rpx;
  border-radius: 22rpx;
  border: 3rpx solid #1E8449;
  background: linear-gradient(135deg, #FFFFFF 0%, #F1F8F1 100%);
  box-shadow: 0 10rpx 26rpx rgba(30, 132, 73, 0.16);
}

.pc-left {
  flex: 1;
  min-width: 0;
}

.pc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E8449;
}

.pc-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B6455;
}

.pc-right {
  text-align: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.pc-count {
  font-size: 44rpx;
  font-weight: 700;
  color: #C0392B;
  line-height: 1;
}

.pc-total {
  font-size: 24rpx;
  color: #A79F8D;
  font-weight: 600;
}

.pc-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A8375;
}

/* 阶段标题（关卡网格上方） */
.stage-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.stage-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #C0392B;
}

.stage-range {
  font-size: 22rpx;
  color: #8A8375;
}
