}
.lamp-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FFE9A8;
  text-shadow: 0 2rpx 10rpx rgba(241, 196, 15, 0.45);
}
.lamp-skip {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A69C88;
}
.lamp-note {
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: #8D8577;
}
