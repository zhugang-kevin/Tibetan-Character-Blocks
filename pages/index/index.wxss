/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #451510 0%, #2E1220 26%, #101F38 62%, #0B1E36 100%);
}

/* ============ 藏文化背景层 ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
/* 真实场景照片层（D47）：铺满页面，位于底图之上、纹样/剪影/色罩之下。
   照片的「去艳与压暗」在 scripts/prepare-assets.py --scene 加工时烘进图里，
   运行时再叠既有夜色罩（.sc-night），不需要 CSS filter（真机兼容更稳）。 */
.sc-photo {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
  object-fit: cover;
}

.sc-bg {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 30rpx; /* 砖为 2:1，方框会纵向拉伸两倍（D39 修正） */
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.16;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.14;
}

/* 夜色罩：压暗四角、突出中心金光，保证前景可读（禁止大白板） */
.sc-night {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 32%,
    rgba(255, 214, 140, 0.08) 0%,
    rgba(16, 22, 42, 0.42) 46%,
    rgba(5, 8, 18, 0.8) 100%);
}

/* Hero：紧凑品牌行（对标消消乐——首页视觉重心是藤蔓地图，品牌只占顶部一行） */
/* 品牌行已移除（2026-10-06 用户拍板）：首页视觉重心交给朝圣天梯，品牌语保留在分享卡与证书 */

.level-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.level-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 36rpx 0;
  border-radius: 20rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #E4DCC8;
  background: #FFFFFF;
}

.level-item.open {
  background: #FFFFFF;
  border-color: #C0392B;
  box-shadow: 0 6rpx 18rpx rgba(192, 57, 43, 0.15);
}

.level-item.done {
  background: #F0F9F0;
  border-color: #1E8449;
}

.level-item.locked {
  background: #F3EFE3;
  border-color: #DDD5C2;
  opacity: 0.75;
}

.level-num {
  font-size: 34rpx;
  font-weight: 600;
}

.locked .level-num {
  color: #6E6759;
}

.done .level-num {
  color: #176B3C;
}

.open .level-num {
  color: #C0392B;
}

.level-state {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.state-done { color: #176B3C; }
.state-open { color: #C0392B; }
.state-locked { color: #6E6759; }

.footer {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C9BFA8;
}

.footer-tagline {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  color: #E8C86B;
}

/* 品牌规范：文字主色用深灰 #2C3E50，不用纯黑 */
page,
.page {
  color: #2C3E50;
}

/* 我的档案：印记 + 连击 */
.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.profile-stamps {
  display: flex;
  gap: 12rpx;
}

.mini-stamp {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border: 3rpx solid #C0392B;
  border-radius: 14rpx;
  color: #C0392B;
  font-size: 26rpx;
  font-weight: 700;
  background: #FDF6E3;
  transform: rotate(-4deg);
}

.profile-combo {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.75), 0 0 22rpx rgba(255, 214, 140, 0.5);
  background: rgba(26, 20, 40, 0.78);
  border: 2rpx solid rgba(212, 175, 55, 0.55);
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
}

/* 文化护照入口 */
.passport-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 26rpx;
  border-radius: 22rpx;
  border: 3rpx solid #1E8449;
  background: linear-gradient(135deg, #FFFFFF 0%, #F1F8F1 100%);
  box-shadow: 0 10rpx 26rpx rgba(30, 132, 73, 0.16);
}

.pc-left {
  flex: 1;
  min-width: 0;
}

.pc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #176B3C;
}

.pc-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B6455;
}

.pc-right {
  text-align: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.pc-count {
  font-size: 44rpx;
  font-weight: 700;
  color: #C0392B;
  line-height: 1;
}

.pc-total {
  font-size: 24rpx;
  color: #6E6759;
  font-weight: 600;
}

.pc-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6E6759;
}

/* 阶段标题（关卡网格上方） */
.stage-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.stage-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFD98A;
}

.stage-range {
  font-size: 22rpx;
  color: #6E6759;
}

/* 权益中心入口（双轨制到店权益） */
.benefit-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 26rpx;
  border-radius: 22rpx;
  border: 3rpx solid #B7950B;
  background: linear-gradient(135deg, #FFFFFF 0%, #FCF6E4 100%);
  box-shadow: 0 10rpx 26rpx rgba(96, 78, 44, 0.12);
}

.bc-left {
  flex: 1;
  min-width: 0;
}

.bc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #8A6A12;
}

.bc-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B6455;
}

.bc-right {
  text-align: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.bc-arrow {
  font-size: 44rpx;
  font-weight: 700;
  color: #8A6A12;
  line-height: 1;
}

.bc-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6E6759;
}

/* ============ PRD v4 首页：资源条 / 藤蔓地图 / 悬浮入口 / 底部平层 / 入口面板 ============ */
.page { padding-bottom: 190rpx; }

/* 顶部资源条（灯油 / 积分 / 唐卡碎片） */
.res-bar {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.res-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(214, 202, 176, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(96, 78, 44, 0.12);
}
.res-ico { font-size: 28rpx; }
.res-val { font-size: 28rpx; font-weight: 700; color: #C0392B; }
.res-cap { font-size: 20rpx; color: #6E6759; }

/* 朝圣天梯地图：山脚（人间）→ 石阶 → 山顶（天堂） */
.vine-map {
  position: relative;
  z-index: 1;
  height: 1080rpx;
  margin: 14rpx 0 8rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: linear-gradient(180deg,
    rgba(255, 214, 120, 0.42) 0%,
    rgba(255, 240, 205, 0.30) 16%,
    rgba(250, 240, 218, 0.34) 42%,
    rgba(122, 108, 138, 0.26) 76%,
    rgba(38, 32, 58, 0.52) 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.55);
}

/* 石阶中轴：灰白石阶引路 + 金色描边中线 */
.vine-stem {
  position: absolute;
  left: 50%;
  top: 13%;
  bottom: 7%;
  width: 22rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: linear-gradient(90deg, #B9BEC4 0%, #E4E7EA 30%, #D5D8DC 55%, #8E979E 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.65);
  box-shadow: inset 4rpx 0 8rpx rgba(255, 255, 255, 0.6), 0 6rpx 16rpx rgba(60, 66, 72, 0.3);
}
.vine-stem::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 6rpx;
  transform: translateX(-50%);
  background-image: linear-gradient(180deg, #D4AF37 0 18rpx, transparent 18rpx 40rpx);
  background-size: 6rpx 40rpx;
  background-repeat: repeat-y;
  opacity: 0.8;
}

/* 天堂层：金色佛光 + 祥云 + 布达拉宫金顶剪影 + 坛城光环 */
.ladder-heaven {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 15%;
  pointer-events: none;
}
.h-glow {
  position: absolute;
  left: 50%;
  top: -46%;
  width: 88%;
  height: 150%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 226, 140, 0.85) 0%, rgba(241, 196, 15, 0.38) 42%, transparent 72%);
}
.h-mandala {
  position: absolute;
  left: 50%;
  top: 6%;
  width: 200rpx;
  height: 200rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 3rpx solid rgba(212, 175, 55, 0.5);
  box-shadow: 0 0 0 16rpx rgba(212, 175, 55, 0.14), 0 0 0 34rpx rgba(212, 175, 55, 0.08);
}
.h-potala {
  position: absolute;
  left: 50%;
  top: 26%;
  width: 240rpx;
  height: 96rpx;
  transform: translateX(-50%);
  background: linear-gradient(180deg, #F1C40F 0%, #B7950B 78%, #8A6A12 100%);
  clip-path: polygon(4% 100%, 4% 66%, 20% 66%, 20% 42%, 36% 42%, 36% 22%, 50% 4%, 64% 22%, 64% 42%, 80% 42%, 80% 66%, 96% 66%, 96% 100%);
  filter: drop-shadow(0 4rpx 10rpx rgba(122, 90, 0, 0.4));
  opacity: 0.92;
}
.h-cloud {
  position: absolute;
  width: 150rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFF7DF 0%, #FFE9A8 100%);
  opacity: 0.85;
  filter: blur(1rpx);
}
.h-cloud::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: -20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: inherit;
}
.h-cloud::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: -14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: inherit;
}
.hc-l { left: 6%; top: 40%; }
.hc-r { right: 6%; top: 52%; transform: scale(0.82); }

/* 山脚村落剪影（人间起点） */
.ladder-village {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 10%;
  background: #221B33;
  clip-path: polygon(0% 100%, 0% 62%, 7% 62%, 7% 40%, 13% 30%, 19% 40%, 19% 58%, 27% 58%, 27% 34%, 33% 34%, 33% 18%, 38% 10%, 43% 18%, 43% 34%, 50% 34%, 50% 56%, 58% 56%, 58% 38%, 64% 38%, 64% 24%, 70% 24%, 70% 44%, 78% 44%, 78% 62%, 86% 62%, 86% 46%, 91% 36%, 96% 46%, 96% 100%);
  opacity: 0.62;
  pointer-events: none;
}

/* 五色经幡：蓝白红绿黄，两侧竖挂 */
.ladder-flags {
  position: absolute;
  top: 18%;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  pointer-events: none;
  opacity: 0.9;
}
.fl-left { left: 10rpx; height: 34%; }
.fl-right { right: 10rpx; top: 34%; height: 34%; }
.ladder-flags .flag {
  width: 16rpx;
  flex: 1;
  border-radius: 0 4rpx 4rpx 0;
  opacity: 0.72;
}
.fl-left .flag { border-radius: 0 4rpx 4rpx 0; }
.fl-right .flag { border-radius: 4rpx 0 0 4rpx; }
.ladder-flags .flag:nth-child(5n + 1) { background: #2471A3; }
.ladder-flags .flag:nth-child(5n + 2) { background: #F6F1E4; }
.ladder-flags .flag:nth-child(5n + 3) { background: #C0392B; }
.ladder-flags .flag:nth-child(5n + 4) { background: #1E8449; }
.ladder-flags .flag:nth-child(5n + 5) { background: #B7950B; }

/* 关卡节点（天梯上的石阶：一级台阶一个节点） */
.level-item.node {
  position: absolute;
  width: 128rpx;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: none;
  border: none;
  padding: 0;
}
.node-deco {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: -4rpx;
  filter: drop-shadow(0 0 8rpx rgba(241, 196, 15, 0.85));
}
.node-badge {
  width: 112rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2E05;
  /* 藏式金阶：古金底 + 金描边 + 顶部高光（2026-10-06 用户拍板：弃灰白石板） */
  background: linear-gradient(180deg, #E8C96A 0%, #D4AF37 46%, #B7950B 100%);
  border: 3rpx solid #B7950B;
  box-shadow: 0 6rpx 14rpx rgba(50, 56, 62, 0.35), inset 0 4rpx 8rpx rgba(255, 246, 220, 0.7), inset 0 -6rpx 10rpx rgba(122, 90, 0, 0.45);
}
.level-item.open .node-badge {
  /* 当前可玩：亮金发光石阶（呼吸动效） */
  background: linear-gradient(180deg, #F7DE8B 0%, #F1C40F 44%, #B7950B 100%);
  border-color: #FFE9A8;
  color: #3D2E05;
  animation: nodePulse 1.8s ease-in-out infinite;
}
.level-item.done .node-badge {
  /* 已通关：袈裟暗红阶 + 金描边（灯光晕） */
  background: linear-gradient(180deg, #B03A2E 0%, #8B241C 55%, #641E16 100%);
  border-color: #D4AF37;
  color: #FFE9A8;
  box-shadow: 0 6rpx 16rpx rgba(241, 196, 15, 0.4), inset 0 4rpx 8rpx rgba(255, 200, 160, 0.25), inset 0 -6rpx 10rpx rgba(40, 8, 4, 0.55);
}
.level-item.locked .node-badge {
  /* 未解锁：暗金哑光阶 + 藏式锁（与「当前可玩」的亮金呼吸区分） */
  background: linear-gradient(180deg, #8A6A12 0%, #7A5F06 52%, #6B5405 100%);
  border-color: rgba(183, 149, 11, 0.8);
  color: #FFF8E1;
  opacity: 0.92;
}
@keyframes nodePulse {
  0%, 100% { box-shadow: 0 6rpx 14rpx rgba(50, 56, 62, 0.35), 0 0 10rpx rgba(241, 196, 15, 0.35), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.7); }
  50% { box-shadow: 0 8rpx 22rpx rgba(181, 137, 0, 0.5), 0 0 30rpx rgba(241, 196, 15, 0.65), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.85); }
}

.node-stars { display: flex; gap: 2rpx; }
.node-stars .star { font-size: 22rpx; line-height: 1; color: #DDD3BC; }
.node-stars .star.on { color: #F1C40F; text-shadow: 0 1rpx 2rpx rgba(120, 90, 0, 0.4); }

/* ============ 天梯动效（入场升起 / 台阶错峰 / 莲花绽放 / 点击回弹） ============ */

/* 入场：整条天梯自山脚升起（位移 + 轻微放大，模拟「向上攀爬」的第一眼） */
.vine-map.in {
  animation: ladderRise 1.05s cubic-bezier(0.2, 0.82, 0.24, 1) both;
}
@keyframes ladderRise {
  0% { opacity: 0; transform: translateY(80rpx) scale(0.986); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 台阶依次浮现（延迟由 WXML 内联 animation-delay 给出，形成自下而上的节奏） */
.vine-map.in .level-item.node {
  animation: nodeRise 0.66s cubic-bezier(0.24, 0.86, 0.28, 1) both;
}
@keyframes nodeRise {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.66); }
  100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

/* 点击回弹：按住时台阶轻微下沉（消消乐式手感，与 hover-class 配合） */
.level-item.node { transition: transform 0.14s ease-out; }
.level-item.node.node-press { transform: translate(-50%, -50%) scale(0.92); }

/* 通关瞬间：台阶上莲花绽放 + 金色光环保开 */
.node-bloom {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46rpx;
  height: 46rpx;
  margin: -23rpx 0 0 -23rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(241, 196, 15, 0.9);
  box-shadow: 0 0 20rpx rgba(241, 196, 15, 0.55);
  pointer-events: none;
  animation: bloomRing 1.15s cubic-bezier(0.16, 0.84, 0.3, 1) both;
}
@keyframes bloomRing {
  0% { transform: scale(0.34); opacity: 0.95; }
  100% { transform: scale(3.8); opacity: 0; }
}
.node-deco.pop {
  animation: lotusBloom 1.2s cubic-bezier(0.2, 0.9, 0.28, 1) both;
}
@keyframes lotusBloom {
  0% { transform: scale(0.2) translateY(12rpx); opacity: 0; filter: drop-shadow(0 0 0 rgba(241, 196, 15, 0)); }
  46% { transform: scale(1.5) translateY(-6rpx); opacity: 1; }
  72% { transform: scale(0.94) translateY(0); }
  100% { transform: scale(1) translateY(0); opacity: 1; filter: drop-shadow(0 0 14rpx rgba(241, 196, 15, 0.9)); }
}

/* 地区剪影：未解锁灰色，解锁后点亮 */
.region {
  position: absolute;
  left: 0;
  right: 0;
  height: 130rpx;
  display: flex;
  align-items: center;
  padding-left: 18rpx;
  transform: translateY(-50%);
  pointer-events: none;
}
.region-shape {
  width: 150rpx;
  height: 92rpx;
  opacity: 0.5;
  background-repeat: no-repeat;
  background-size: contain;
}
.region.dim .region-shape { filter: grayscale(1) brightness(1.16); opacity: 0.34; }
.region.lit .region-shape { filter: none; opacity: 0.72; }
.region-txt { margin-left: 14rpx; display: flex; flex-direction: column; }
.region-name { font-size: 24rpx; font-weight: 700; color: #6B6455; }
.region.dim .region-name { color: #6E6759; }
.region-spot { font-size: 20rpx; color: #6E6759; }

/* 五地剪影造型（简笔线条感，用 CSS 形状表达） */
.region-shape.potala {
  background: linear-gradient(180deg, #B7950B 0%, #8A6A12 100%);
  clip-path: polygon(6% 100%, 6% 62%, 22% 62%, 22% 40%, 38% 40%, 38% 20%, 50% 8%, 62% 20%, 62% 40%, 78% 40%, 78% 62%, 94% 62%, 94% 100%);
}
.region-shape.forest { background: #1E8449; clip-path: polygon(0% 100%, 16% 46%, 30% 74%, 44% 30%, 58% 70%, 72% 40%, 88% 78%, 100% 100%); }
.region-shape.valley { background: #2471A3; clip-path: polygon(0% 100%, 0% 62%, 26% 30%, 50% 58%, 74% 26%, 100% 58%, 100% 100%); }
.region-shape.monastery { background: #C0392B; clip-path: polygon(4% 100%, 4% 58%, 20% 58%, 20% 34%, 50% 12%, 80% 34%, 80% 58%, 96% 58%, 96% 100%); }
.region-shape.snow { background: #5D6D7E; clip-path: polygon(0% 100%, 30% 22%, 44% 52%, 58% 10%, 72% 48%, 100% 100%); }

/* 左右悬浮入口 */
.side-rail {
  position: fixed;
