<view class="page">
  <!-- 藏文化背景层（六层：全局底图 / 纹样 / 藏纸颗粒 / 雪山布达拉宫 / 经幡 / 夜色罩） -->
  <view class="scenery" aria-hidden="true">
    <image class="sc-bg" src="/images/bg-global.jpg" mode="aspectFill" />
    <view class="sc-pattern"></view>
    <view class="grain"></view>
    <image class="sc-ground" src="/images/bg-ground.png" mode="widthFix" />
    <image class="sc-sky" src="/images/bg-sky.png" mode="widthFix" />
    <view class="sc-night"></view>
  </view>

  <!-- 顶部资源条（灯油 / 积分 / 唐卡碎片） -->
  <view class="res-bar">
    <view class="res-item"><text class="res-ico">🪔</text><text class="res-val">{{oil}}</text><text class="res-cap">灯油</text></view>
    <view class="res-item"><text class="res-ico">✧</text><text class="res-val">{{points}}</text><text class="res-cap">学习得分</text></view>
    <view class="res-item"><text class="res-ico">🖼</text><text class="res-val">{{fragCount}}/9</text><text class="res-cap">唐卡</text></view>
  </view>

  <!-- 我的档案：护照印记 + 最高连续正确 -->
  <view wx:if="{{stamps.length || bestCombo > 1}}" class="profile-row">
    <view class="profile-stamps">
      <view wx:for="{{stamps}}" wx:key="id" class="mini-stamp">{{item.name}}</view>
    </view>
    <view wx:if="{{bestCombo > 1}}" class="profile-combo">最高连续正确 ×{{bestCombo}}</view>
  </view>

  <!-- 朝圣天梯地图：山脚（人间）→ 石阶关卡 → 山顶（天堂/净土），五地剪影随进度点亮 -->
  <view class="stage-head">
    <text class="stage-name">朝圣天梯 · 第一段</text>
    <text class="stage-range">第 1-10 课 · 山脚到山腰 · 完成可得证书</text>
  </view>

  <view class="vine-map {{ladderIn ? 'in' : ''}}">
    <!-- 天堂层：金色佛光 + 祥云 + 布达拉宫金顶剪影 + 坛城光环（纯装饰，不可点） -->
    <view class="ladder-heaven" aria-hidden="true">
      <view class="h-glow"></view>
      <view class="h-mandala"></view>
      <view class="h-cloud hc-l"></view>
      <view class="h-cloud hc-r"></view>
      <view class="h-potala"></view>
    </view>

    <!-- 山脚村落剪影（人间起点，纯装饰） -->
    <view class="ladder-village" aria-hidden="true"></view>

    <!-- 五色经幡（两侧竖挂，象征祝福与传播，纯装饰） -->
    <view class="ladder-flags fl-left" aria-hidden="true">
      <view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view>
    </view>
    <view class="ladder-flags fl-right" aria-hidden="true">
      <view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view><view class="flag"></view>
    </view>

    <!-- 地区剪影：未解锁为灰色剪影，解锁后点亮 -->
    <view
      wx:for="{{regions}}"
      wx:key="id"
      class="region {{item.lit ? 'lit' : 'dim'}}"
      style="top: {{item.top}}%; left: {{item.left}}%;"
    >
      <view class="region-shape {{item.shape}}"></view>
      <view class="region-txt">
        <text class="region-name">{{item.name}}</text>
        <text class="region-spot">{{item.lit ? item.spot : '未解锁'}}</text>
      </view>
    </view>

    <!-- 石阶中轴：金色描边的藏式石阶引路 -->
    <view class="vine-stem"></view>

    <!-- 关卡节点：每关是一级石阶，节点下显示星级；按住有下沉回弹 -->
    <view
      wx:for="{{levels}}"
      wx:key="n"
      class="level-item node {{item.unlocked ? (item.done ? 'done' : 'open') : 'locked'}}"
      style="top: {{item.top}}%; left: {{item.left}}%; animation-delay: {{item.delay}}ms;"
      hover-class="node-press"
      hover-stay-time="140"
      data-n="{{item.n}}"
      bindtap="onTapLevel"
    >
      <view wx:if="{{item.bloom}}" class="node-bloom"></view>
      <view wx:if="{{item.done || item.bloom}}" class="node-deco {{item.bloom ? 'pop' : ''}}">🪷</view>
      <view class="node-badge">
        <text wx:if="{{item.unlocked}}">{{item.n}}</text>
        <text wx:else>🔒</text>
      </view>
      <view class="node-stars">
        <text class="star {{item.s1}}">★</text><text class="star {{item.s2}}">★</text><text class="star {{item.s3}}">★</text>
      </view>
    </view>
  </view>

  <!-- 文化护照入口（总档案：12 张藏文成长证书 + 印章 + 收藏） -->
  <view class="passport-card" bindtap="openPassport">
    <view class="pc-left">
      <view class="pc-title">我的西藏文化护照</view>
      <view wx:if="{{stage}}" class="pc-sub">
        第 {{stage.stage}} 阶段 · {{stage.name}} · 进度 {{stage.progress}}/{{stage.total}} 课
      </view>
      <view wx:elif="{{lastCert}}" class="pc-sub">
        最近获得：第 {{lastCert.stage}} 阶段 · {{lastCert.tierLabel}}
      </view>
      <view wx:else class="pc-sub">完成第 10 课，获得第一张藏文成长证书</view>
    </view>
    <view class="pc-right">
      <view class="pc-count">{{certCount}}<text class="pc-total">/{{certTotal}}</text></view>
      <view class="pc-label">成长证书</view>
    </view>
  </view>

  <view class="footer">
    <view class="footer-tagline">每个字母，都是一座西藏</view>
    <view>共 10 课 · 进度自动保存在本机</view>
  </view>

  <!-- 左侧悬浮入口 -->
  <view class="side-rail left">
    <view class="side-btn" data-panel="journal" bindtap="openPanel">
      <text class="side-ico">📖</text><text class="side-txt">雪域游记</text>
    </view>
    <view class="side-btn" data-panel="lamp" bindtap="openPanel">
      <text class="side-ico">🪔</text><text class="side-txt">长明灯</text>
      <text wx:if="{{canSignIn}}" class="side-dot">2</text>
    </view>
    <view class="side-btn" data-panel="market" bindtap="openPanel">
      <text class="side-ico">🏮</text><text class="side-txt">八廓集市</text>
    </view>
    <view class="side-btn" data-panel="daily" bindtap="openPanel">
      <text class="side-ico">📜</text><text class="side-txt">雪域日签</text>
    </view>
  </view>

  <!-- 右侧悬浮入口 -->
  <view class="side-rail right">
    <view class="side-btn" data-panel="thangka" bindtap="openPanel">
      <text class="side-ico">🖼</text><text class="side-txt">唐卡拼图</text>
    </view>
    <view class="side-btn" data-panel="box" bindtap="openPanel">
      <text class="side-ico">🎁</text><text class="side-txt">非遗盲盒</text>
    </view>
  </view>

  <!-- 底部大平层 -->
  <view class="dock">
    <view class="dock-btn" data-panel="shop" bindtap="openPanel"><text class="dock-ico">🧰</text><text class="dock-txt">道具铺</text></view>
    <view class="dock-btn" data-panel="rank" bindtap="openPanel"><text class="dock-ico">🏔</text><text class="dock-txt">我的成绩</text></view>
    <view class="dock-btn" data-panel="tree" bindtap="openPanel"><text class="dock-ico">🌳</text><text class="dock-txt">菩提树</text></view>
    <view class="dock-btn" data-panel="winter" bindtap="openPanel"><text class="dock-ico">❄</text><text class="dock-txt">冬游西藏</text></view>
  </view>

  <!-- 入口面板（统一底部滑出容器，非阻塞） -->
  <view class="entry-panel {{panelShow ? 'show' : ''}}">
    <view class="entry-head">
      <text class="entry-title">{{panelTitle}}</text>
      <text class="entry-x" bindtap="closePanel">✕</text>
    </view>
    <scroll-view class="entry-body" scroll-y>

      <!-- 雪域游记 -->
      <block wx:if="{{panel === 'journal'}}">
        <view class="entry-grid">
          <view class="entry-metric"><text class="em-v">{{journal.letters}}</text><text class="em-k">已认识字母</text></view>
          <view class="entry-metric"><text class="em-v">{{journal.cards}}</text><text class="em-k">看过的文化卡</text></view>
          <view class="entry-metric"><text class="em-v">{{journal.done}}</text><text class="em-k">已完成</text></view>
          <view class="entry-metric"><text class="em-v">{{journal.stars}}</text><text class="em-k">累计星星</text></view>
        </view>
        <view class="entry-note">今天也可继续：每消一对，就多认识一个字。</view>
      </block>

      <!-- 祈福长明灯（7 天循环签到） -->
      <block wx:elif="{{panel === 'lamp'}}">
        <view class="lamp-row">
          <view class="lamp-ring" wx:for="{{lampDays}}" wx:key="day">
            <view class="lamp-dot {{item.on ? 'on' : ''}}"><text>{{item.day}}</text></view>
            <text class="lamp-label">{{item.label}}</text>
          </view>
        </view>
        <view class="entry-note">连续签到 {{signIn.streak}} 天 · 灯油 {{signIn.oil}} · 累计 {{signIn.totalDays}} 天</view>
        <view class="entry-btn {{canSignIn ? '' : 'off'}}" bindtap="doSignIn">{{canSignIn ? '点亮今日酥油灯' : '今日已点亮 · 明天再来'}}</view>
        <view class="entry-note">签到奖励全部为本地学习得分与道具，不含任何金额，也不需要登录。</view>
      </block>

      <!-- 雪域日签 -->
      <block wx:elif="{{panel === 'daily'}}">
        <view class="daily-tib tibetan">{{daily.tibetan}}</view>
        <view class="daily-roman">{{daily.roman}}</view>
        <view class="daily-cn">{{daily.cn}}</view>
        <view class="entry-note">{{daily.tip}}</view>
        <view class="entry-btn" bindtap="makeBlessingCard">生成今日祝福签卡片</view>
        <image wx:if="{{blessingImage}}" class="bless-img" src="{{blessingImage}}" mode="widthFix"></image>
        <view wx:if="{{blessingImage}}" class="entry-btn" bindtap="saveBlessingCard">保存到相册</view>
        <view wx:if="{{blessingImage}}" class="entry-btn" bindtap="shareBlessingCard">分享给朋友</view>
        <view class="entry-note">卡片内容只来自本地日签：不设分享奖励、不含任何金额，可自由保存。</view>
      </block>

      <!-- 唐卡拼图（9 片收集 + 合成动作） -->
      <block wx:elif="{{panel === 'thangka'}}">
        <view class="tk-grid {{thangkaDone ? 'done' : ''}}">
          <view wx:for="{{thangkaCells}}" wx:key="i" class="tk-cell {{item.on ? 'on' : ''}}">
            <text wx:if="{{item.on}}" class="tk-mark">✦</text>
            <text wx:else class="tk-mark dim">{{item.i}}</text>
          </view>
        </view>
        <view wx:if="{{thangkaDone}}" class="tk-frame-note">已合成 · 完整图收入文化护照</view>
        <view wx:elif="{{fragCount >= 9}}" class="entry-btn" bindtap="synthesizeThangka">合成唐卡 · 收入文化护照</view>
        <view class="entry-note">{{fragCount}}/9 片 · {{thangkaDone ? '已成一幅，可到文化护照查看' : (fragCount >= 9 ? '碎片已集齐，点上方按钮合成' : '还差 ' + (9 - fragCount) + ' 片就能看全图了')}}</view>
      </block>

      <!-- 非遗盲盒（只抽文化小知识） -->
      <block wx:elif="{{panel === 'box'}}">
        <view class="box-open" bindtap="openBox">🎁 抽取今日非遗小知识</view>
        <view wx:if="{{boxText}}" class="box-text">{{boxText}}</view>
        <view class="entry-note">盲盒只装文化小知识：不发放优惠券、不涉及任何金额与交易。</view>
      </block>

      <!-- 藏式道具铺（积分兑换，不涉及支付） -->
      <block wx:elif="{{panel === 'shop'}}">
        <view class="shop-row" wx:for="{{shopItems}}" wx:key="id">
          <view class="shop-ico">{{item.icon}}</view>
          <view class="shop-main">
            <view class="shop-name">{{item.name}} <text class="shop-count">持有 {{item.have}}</text></view>
            <view class="shop-desc">{{item.desc}}</view>
          </view>
          <view class="shop-btn" data-id="{{item.id}}" bindtap="buyItem">{{item.cost}} 学习得分</view>
        </view>
        <view class="entry-note">道具用学习得分兑换：全程不涉及支付，也不含广告。</view>
      </block>

      <!-- 我的成绩（本地记录） -->
      <block wx:elif="{{panel === 'rank'}}">
        <view class="rank-row"><text class="rank-k">累计学习得分</text><text class="rank-v">{{points}}</text></view>
        <view class="rank-row"><text class="rank-k">最高连续正确</text><text class="rank-v">×{{bestCombo}}</text></view>
        <view class="rank-row"><text class="rank-k">累计星星</text><text class="rank-v">{{journal.stars}}</text></view>
        <view class="rank-row"><text class="rank-k">已认识字母</text><text class="rank-v">{{journal.letters}}</text></view>
        <view class="entry-note">这是你自己的雪域成绩单：全部数据保存在本机，不上传、不做全服排名。</view>
      </block>

      <!-- 菩提树 -->
      <block wx:elif="{{panel === 'tree'}}">
        <view class="tree-art">🌳</view>
        <view class="entry-note">已浇水 {{pot}} 次 · 每次收获 12 学习得分</view>
        <view class="entry-btn" bindtap="waterTree">给菩提树浇一次水</view>
        <view class="entry-note">浇树只用学习得分循环，不依赖广告，也不售卖任何东西。</view>
      </block>

      <!-- 冬游西藏 -->
      <block wx:elif="{{panel === 'winter'}}">
        <view class="winter-card" wx:for="{{winterItems}}" wx:key="title">
          <view class="wc-title">{{item.title}}</view>
          <view class="wc-text">{{item.text}}</view>
        </view>
      </block>

      <!-- 八廓街集市 → 藏文权益中心（双轨制到店权益，已有页面） -->
      <block wx:elif="{{panel === 'market'}}">
        <view class="entry-note">八廓街集市即「藏文权益中心」：用课程进度领取由商家提供并兑现的到店体验，平台不参与交易、不经手资金。</view>
        <view class="entry-btn" bindtap="openBenefits">进入藏文权益中心</view>
      </block>

    </scroll-view>
    <view class="entry-foot">{{panelFoot}}</view>
  </view>

  <!-- 万家灯火：进入主界面前的静态祈福跳窗（每天首次打开一次；全部为本地固定数据，无任何网络请求） -->
  <view wx:if="{{lampShow}}" class="lamp-mask">
    <view class="lamp-card">
      <view class="lamp-halo"></view>
      <view class="lamp-title">{{lampTitle}}</view>
      <!-- 主数字走万/亿口径（12.85万）；精确值在下一行的句子里（128,457 盏灯） -->
      <view class="lamp-total {{lampTotalPop ? 'pop' : ''}}">{{lampTotalText}}<text class="lamp-unit">盏</text></view>
      <view class="lamp-sub {{lampTotalPop ? 'pop' : ''}}">{{lampSub}}</view>

      <!-- 3D 酥油灯 + CSS 火焰 -->
      <view class="lamp-flame">
        <view class="flame-glow"></view>
        <view class="flame f1"></view>
        <view class="flame f2"></view>
        <view class="flame f3"></view>
        <view class="lamp-body">
          <view class="lamp-cup"></view>
          <view class="lamp-foot"></view>
        </view>
        <view wx:if="{{lampLit}}" class="sparks">
          <view class="spark"></view><view class="spark"></view><view class="spark"></view>
          <view class="spark"></view><view class="spark"></view><view class="spark"></view>
          <view class="spark"></view><view class="spark"></view><view class="spark"></view>
          <view class="spark"></view><view class="spark"></view><view class="spark"></view>
        </view>
      </view>

      <!-- 各地灯火：辉光等级按行号循环取 1..4，纯装饰，与灯火数量无关（不标示高低与位次） -->
      <view class="lamp-sec">各地灯火</view>
      <view class="lamp-list">
        <view class="lamp-item" wx:for="{{lampProvinces}}" wx:key="name">
          <view class="lamp-l">
            <view class="lamp-gl glow-{{item.glow}}" style="animation-delay:{{item.glowDelay}}"></view>
            <text class="lamp-p">{{item.name}}</text>
          </view>
          <text class="lamp-c">{{item.countText}}</text>
        </view>
      </view>
      <view class="lamp-home">{{lampHomeText}}</view>

      <view class="lamp-sec">两色莲花</view>
      <view class="lamp-lotus">
        <view class="lotus-cell gold">
          <text class="lotus-ico">🪷</text>
          <text class="lotus-k">金色莲花</text>
          <text class="lotus-v">{{lampLotus.goldText}}</text>
        </view>
        <view class="lotus-cell pink">
          <text class="lotus-ico">🌸</text>
          <text class="lotus-k">粉色莲花</text>
          <text class="lotus-v">{{lampLotus.pinkText}}</text>
        </view>
      </view>

      <view class="lamp-btn {{lampLit ? 'lit' : ''}}" bindtap="onLightLamp">{{lampButtonText}}</view>
      <view wx:if="{{lampLit}}" class="lamp-tip">{{lampTip}}</view>
      <text class="lamp-skip" bindtap="closeLampWindow">今天先不点灯</text>
      <view class="lamp-note">{{lampOnceNote}}</view>
    </view>
  </view>

</view>
