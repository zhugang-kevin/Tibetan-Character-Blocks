<view class="page">
  <view class="hero">
    <image class="hero-logo" src="/images/logo-200.png" mode="aspectFit" />
    <view class="hero-title">藏字方块</view>
    <view class="hero-slogan">玩方块，认藏文</view>
    <view class="hero-sub">点击两张相同的藏文字母或文化图标进行配对消除，边玩边认藏文</view>
  </view>

  <view class="level-grid">
    <view
      wx:for="{{levels}}"
      wx:key="n"
      class="level-item {{item.unlocked ? (item.done ? 'done' : 'open') : 'locked'}}"
      data-n="{{item.n}}"
      bindtap="onTapLevel"
    >
      <view class="level-num">第 {{item.n}} 关</view>
      <view class="level-state">
        <text wx:if="{{item.done}}" class="state-done">✓ 已通关</text>
        <text wx:elif="{{item.unlocked}}" class="state-open">开始</text>
        <text wx:else class="state-locked">🔒 未解锁</text>
      </view>
    </view>
  </view>

  <view class="footer">共 10 关 · 进度自动保存在本机</view>
</view>
