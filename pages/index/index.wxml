<view class="page">
  <!-- 藏文化背景层（三层：纹样 / 经幡 / 雪山布达拉宫） -->
  <view class="scenery" aria-hidden="true">
    <view class="sc-pattern"></view>
    <image class="sc-ground" src="/images/bg-ground.png" mode="widthFix" />
    <image class="sc-sky" src="/images/bg-sky.png" mode="widthFix" />
  </view>

  <view class="hero">
    <image class="hero-logo" src="/images/logo-200.png" mode="aspectFit" />
    <view class="hero-title">藏字方块</view>
    <view class="hero-slogan">玩方块，认藏文</view>
    <view class="hero-sub">点击两张相同的藏文字母或文化图标进行配对消除，边玩边认藏文</view>
  </view>

  <!-- 我的档案：护照印记 + 最高连击 -->
  <view wx:if="{{stamps.length || bestCombo > 1}}" class="profile-row">
    <view class="profile-stamps">
      <view wx:for="{{stamps}}" wx:key="id" class="mini-stamp">{{item.name}}</view>
    </view>
    <view wx:if="{{bestCombo > 1}}" class="profile-combo">最高连击 ×{{bestCombo}}</view>
  </view>

  <!-- 文化护照入口（总档案：12 张藏文成长证书 + 印章 + 收藏） -->
  <view class="passport-card" bindtap="openPassport">
    <view class="pc-left">
      <view class="pc-title">我的西藏文化护照</view>
      <view wx:if="{{stage}}" class="pc-sub">
        第 {{stage.stage}} 阶段 · {{stage.name}} · 进度 {{stage.progress}}/{{stage.total}} 关
      </view>
      <view wx:elif="{{lastCert}}" class="pc-sub">
        最近获得：第 {{lastCert.stage}} 阶段 · {{lastCert.tierLabel}}
      </view>
      <view wx:else class="pc-sub">通关第 10 关，获得第一张藏文成长证书</view>
    </view>
    <view class="pc-right">
      <view class="pc-count">{{certCount}}<text class="pc-total">/{{certTotal}}</text></view>
      <view class="pc-label">成长证书</view>
    </view>
  </view>

  <view class="stage-head">
    <text class="stage-name">第一阶段 · 简单基字</text>
    <text class="stage-range">第 1-10 关 · 通关可得证书</text>
  </view>

  <view class="level-grid">
    <view
      wx:for="{{levels}}"
      wx:key="n"
      class="level-item {{item.unlocked ? (item.done ? 'done' : 'open') : 'locked'}}"
      data-n="{{item.n}}"
      bindtap="onTapLevel"
    >
      <view class="level-num">第 {{item.n}} 关</view>
      <view class="level-state">
        <text wx:if="{{item.done}}" class="state-done">✓ 已通关</text>
        <text wx:elif="{{item.unlocked}}" class="state-open">开始</text>
        <text wx:else class="state-locked">🔒 未解锁</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="footer-tagline">每个字母，都是一座西藏</view>
    <view>共 10 关 · 进度自动保存在本机</view>
  </view>
</view>
