<view class="page">

  <!-- 藏文化背景层（六层：全局底图 / 纹样 / 藏纸颗粒 / 雪山布达拉宫 / 经幡 / 夜色罩） -->
  <view class="scenery" aria-hidden="true">
    <image class="sc-bg" src="/images/bg-global.jpg" mode="aspectFill" />
    <view class="sc-pattern"></view>
    <view class="grain"></view>
    <image class="sc-ground" src="/images/bg-ground.png" mode="widthFix" />
    <image class="sc-sky" src="/images/bg-sky.png" mode="widthFix" />
    <view class="sc-night"></view>
  </view>

  <view class="content">

    <!-- 护照封面 -->
    <view class="passport-cover">
      <image class="cover-logo" src="/images/logo-144.png" mode="aspectFit" />
      <view class="cover-title">我的西藏文化护照</view>
      <view class="cover-holder">{{holder ? '持有人 · ' + holder : '持有人 · 未填写'}}</view>
      <view class="cover-slogan">每一个字母，都是一座西藏</view>
    </view>

    <!-- 0. 我的资料（D54）：性别 + 藏族名字
         三条硬规矩：只由用户自己点选 / 有「不愿透露」出口 / 可随时修改或清除。
         性别只用于挑一个对应性别的藏族名字，不用于别的任何地方。 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">我的资料</text>
        <text class="section-count">{{genderLabel}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-k">藏族名字</text>
        <text class="profile-v {{tibetanName ? '' : 'empty'}}">{{tibetanName ? tibetanName + '（' + tibetanNameMean + '）' : '尚未获得'}}</text>
      </view>
      <view class="profile-note">性别只用来为你挑一个对应的藏族名字（藏族名字分男女）。只保存在本机，不上传、不同步。</view>
      <view class="profile-actions">
        <view class="pa-btn" bindtap="toggleProfileEdit">{{profileEdit ? '收起' : '修改性别'}}</view>
        <view wx:if="{{gender}}" class="pa-btn ghost" bindtap="clearGender">清除</view>
      </view>
      <view wx:if="{{profileEdit}}" class="gender-pick">
        <view
          wx:for="{{genderOptions}}"
          wx:key="key"
          class="gp-item {{item.key === gender ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="pickGender"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 1. 藏文成长证书（学习线） -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">藏文成长证书</text>
        <text class="section-count">{{owned}} / {{certTotal}}</text>
      </view>
      <view class="section-sub">每 10 课一个阶段，完成即颁发一张证书。集齐 12 张，就是一套完整的藏文入门档案。</view>

      <view class="cert-grid">
        <view
          wx:for="{{certs}}"
          wx:key="stage"
          class="cert-slot {{item.unlocked ? 'got' : 'locked'}}"
          data-stage="{{item.stage}}"
          bindtap="openCert"
        >
          <view class="slot-top">第 {{item.stage}} 阶段</view>
          <view class="slot-name">{{item.name}}</view>
          <block wx:if="{{item.unlocked}}">
            <view class="slot-tier" style="background: {{item.tierColor}};">{{item.tierLabel}}</view>
            <view class="slot-no">{{item.cert.no}}</view>
          </block>
          <block wx:else>
            <view class="slot-lock">🔒</view>
            <view class="slot-progress">{{item.progress}}/{{item.total}} 课</view>
          </block>
        </view>
      </view>

      <view wx:if="{{nextStage}}" class="next-hint">
        下一张：第 {{nextStage.stage}} 阶段 · {{nextStage.name}}
        <text class="next-need">还差 {{nextStage.total - nextStage.progress}} 课</text>
      </view>
    </view>

    <!-- 2. 文化收藏册 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">文化收藏册</text>
        <text class="section-count">{{cardsSeen}} / {{cardsTotal}}</text>
      </view>
      <view class="section-sub">每第一次消除一种藏文字母或文化元素，就会收藏一张文化卡。</view>
      <view class="bar"><view class="bar-in" style="width: {{cardsTotal ? (cardsSeen * 100 / cardsTotal) : 0}}%;"></view></view>
    </view>

    <!-- 2.5 唐卡收藏：首页承诺「完整图收入文化护照」，本节兑现它（2026-10-05） -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">唐卡收藏</text>
        <text class="section-count">{{fragCount}} / 9</text>
      </view>
      <view class="section-sub">每完成一课掉落一片唐卡碎片；集齐 9 片回首页「唐卡拼图」面板点「合成唐卡」。</view>
      <view class="tk-grid {{thangkaDone ? 'done' : ''}}">
        <view wx:for="{{thangkaCells}}" wx:key="i" class="tk-cell {{item.on ? 'on' : ''}}">
          <text wx:if="{{item.on}}" class="tk-mark">✦</text>
          <text wx:else class="tk-mark dim">{{item.i}}</text>
        </view>
      </view>
      <view wx:if="{{thangkaDone}}" class="tk-frame-note">唐卡已合成 · 你的第一幅完整唐卡</view>
      <view wx:else class="bar"><view class="bar-in" style="width: {{fragCount * 100 / 9}}%;"></view></view>
    </view>

    <!-- 2.6 揭示图鉴（D31）：十关各一张秘境图，完成即揭晓收入 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">揭示图鉴</text>
        <text class="section-count">{{revealGot}} / {{revealTotal}}</text>
      </view>
      <view class="section-sub">每一课的棋盘下都垫着一张秘境图，消除越多透出越多，完成后整幅揭晓。</view>
      <view class="rv-grid">
        <view wx:for="{{revealSlots}}" wx:key="level" class="rv-slot {{item.unlocked ? 'got' : 'locked'}}">
          <view class="rv-frame">
            <image wx:if="{{item.unlocked}}" class="rv-img" src="{{item.img}}" mode="aspectFill" />
            <text wx:else class="rv-lock-mark">🔒</text>
          </view>
          <view class="rv-name">{{item.unlocked ? item.name : ('第 ' + item.level + ' 课')}}</view>
        </view>
      </view>
    </view>

    <!-- 2.7 藏地密码（PRD 5.2）：十则藏地小知识，完成即解锁收入。
         未解锁的槽位只给关卡号、不给标题（不剧透），与收藏册的「?」同一用意。 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">藏地密码</text>
        <text class="section-count">{{secretGot}} / {{secretTotal}}</text>
      </view>
      <view class="section-sub">每完成一课，解锁一则藏在高原生活里的密码 —— 从雪线到音节点，共十则。</view>
      <view class="se-grid">
        <view wx:for="{{secretSlots}}" wx:key="level" class="se-slot {{item.got ? 'got' : 'locked'}}">
          <view class="se-tag">{{item.got ? item.tag : '尚未解锁'}}</view>
          <view class="se-title">{{item.got ? item.title : ('第 ' + item.level + ' 号')}}</view>
        </view>
      </view>
    </view>

    <!-- 3. 地区印章 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">地区印章</text>
        <text class="section-count">{{stampOwned}} / {{stampTotal}}</text>
      </view>
      <view class="stamp-row">
        <view wx:for="{{stamps}}" wx:key="id" class="stamp-item">
          <view class="stamp-seal">{{item.name}}</view>
          <view class="stamp-desc">{{item.desc}}</view>
        </view>
        <view class="stamp-empty">更多印章陆续开放（规划七地市）</view>
      </view>
    </view>

    <!-- 4. 现实足迹 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">现实足迹</text>
        <text class="section-count">敬请期待</text>
      </view>
      <view class="section-sub">记录你在现实中去过的藏文化地点。完成打卡后会在这里留下一枚足迹。</view>
    </view>

    <!-- 5. 个人文化图谱 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">个人文化图谱</text>
        <text class="section-count">成长中</text>
      </view>
      <view class="graph-row">
        <view class="graph-item">
          <text class="graph-v">{{levelsDone}}</text>
          <text class="graph-k">已完成课程</text>
        </view>
        <view class="graph-item">
          <text class="graph-v">{{owned}}</text>
          <text class="graph-k">成长证书</text>
        </view>
        <view class="graph-item">
          <text class="graph-v">{{cardsSeen}}</text>
          <text class="graph-k">文化卡</text>
        </view>
        <view class="graph-item">
          <text class="graph-v">×{{bestCombo}}</text>
          <text class="graph-k">最高连续正确</text>
        </view>
      </view>
    </view>

    <button class="home-btn" bindtap="goHome">返回首页</button>

  </view>
</view>
