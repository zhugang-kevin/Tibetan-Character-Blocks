/* pages/passport/passport.wxss — 我的西藏文化护照 */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 80rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #451510 0%, #2E1220 26%, #101F38 62%, #0B1E36 100%);
  color: #2C3E50;
}

/* ============ 藏文化背景层（与首页/游戏页/结算页统一） ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-bg {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.16;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.14;
}

/* 夜色罩：压暗四角、突出中心金光，保证前景可读（禁止大白板） */
.sc-night {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 32%,
    rgba(255, 214, 140, 0.08) 0%,
    rgba(16, 22, 42, 0.42) 46%,
    rgba(5, 8, 18, 0.8) 100%);
}

.content {
  position: relative;
  z-index: 1;
}

/* ============ 护照封面 ============ */
.passport-cover {
  text-align: center;
  padding: 40rpx 30rpx 44rpx;
  border-radius: 28rpx;
  border: 4rpx solid #1E8449;
  background: linear-gradient(180deg, #FFFFFF 0%, #F3F8F2 100%);
  box-shadow: 0 12rpx 34rpx rgba(96, 78, 44, 0.18);
  margin-bottom: 30rpx;
}

.cover-logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 30rpx;
}

.cover-title {
  margin-top: 20rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #176B3C;
}

.cover-holder {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6B6455;
}

.cover-slogan {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8A6A12;
  letter-spacing: 2rpx;
}

/* ============ 分区 ============ */
.section {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 22rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(96, 78, 44, 0.1);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
}

.section-count {
  font-size: 26rpx;
  font-weight: 700;
  color: #C0392B;
}

.section-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6E6759;
  line-height: 1.7;
}

/* ============ 证书 12 格 ============ */
.cert-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.cert-slot {
  width: 31.5%;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  padding: 18rpx 8rpx 14rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #E4DCC8;
  background: #FDF6E3;
}

.cert-slot.got {
  border-color: #B7950B;
  background: linear-gradient(180deg, #FFFDF3 0%, #FBF1D8 100%);
  box-shadow: 0 6rpx 16rpx rgba(183, 149, 11, 0.22);
}

.cert-slot.locked {
  opacity: 0.72;
  background: #F3EFE3;
  border-color: #DDD5C2;
}

.slot-top {
  font-size: 20rpx;
  color: #6E6759;
}

.slot-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  min-height: 64rpx;
  color: #2C3E50;
}

.cert-slot.locked .slot-name {
  color: #6E6759;
}

.slot-tier {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.slot-no {
  margin-top: 8rpx;
  font-size: 16rpx;
  color: #6E6759;
  transform: scale(0.92);
}

.slot-lock {
  margin-top: 6rpx;
  font-size: 26rpx;
}

.slot-progress {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #6E6759;
}

.next-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #176B3C;
  display: flex;
  justify-content: space-between;
}

.next-need {
  font-weight: 700;
  color: #C0392B;
}

/* ============ 进度条 ============ */
.bar {
  margin-top: 20rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #EFE7D4;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #C0392B 0%, #B7950B 100%);
}

/* ============ 印章 ============ */
.stamp-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.stamp-item {
  text-align: center;
}

.stamp-seal {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border: 4rpx solid #C0392B;
  border-radius: 18rpx;
  color: #C0392B;
  font-size: 34rpx;
  font-weight: 700;
  background: #FDF6E3;
  transform: rotate(-5deg);
}

.stamp-desc {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #6E6759;
}

.stamp-empty {
  flex: 1;
  font-size: 22rpx;
  color: #6E6759;
  line-height: 1.6;
}

/* ============ 图谱 ============ */
.graph-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.graph-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.graph-v {
  font-size: 40rpx;
  font-weight: 700;
  color: #C0392B;
}

.graph-k {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6E6759;
}

/* ============ 揭示图鉴（D31）：十关秘境图，5 列方格 ============ */
.rv-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.rv-slot {
  width: calc((100% - 56rpx) / 5);
  text-align: center;
}
.rv-frame {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid rgba(183, 149, 11, 0.5);
  background: #0D2137;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rv-slot.got .rv-frame {
  border-color: #B7950B;
  box-shadow: 0 4rpx 12rpx rgba(183, 149, 11, 0.24);
}
.rv-slot.locked .rv-frame {
  background: #F3EFE3;
  border-color: #DDD5C2;
}
.rv-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.rv-lock-mark { font-size: 30rpx; opacity: 0.6; }
.rv-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #2C3E50;
  line-height: 1.3;
}
.rv-slot.locked .rv-name { color: #6E6759; }

/* ============ 底部 ============ */
.home-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}
