<view class="page has-bar">

  <!-- 藏文化背景层（六层：全局底图 / 纹样 / 藏纸颗粒 / 雪山布达拉宫 / 经幡 / 夜色罩） -->
  <view class="scenery" aria-hidden="true">
    <image class="sc-bg" src="/images/bg-global.jpg" mode="aspectFill" />
    <view class="sc-pattern"></view>
    <view class="grain"></view>
    <image class="sc-ground" src="/images/bg-ground.png" mode="widthFix" />
    <image class="sc-sky" src="/images/bg-sky.png" mode="widthFix" />
    <view class="sc-night"></view>
  </view>

  <!-- 唐卡画卷：进入结算时缓缓展开（.unfurl 动画），上下两根卷轴杆 -->
  <view class="content unfurl">
  <view class="roller roller-top" aria-hidden="true"></view>

  <view class="result-hero">
    <view class="result-check">✓</view>
    <!-- D111 学习线：标题走「L{级} · 第{课}课」；老 10 关线不变 -->
    <view class="result-title">{{learnMode ? ('L' + learnLv + ' · 第 ' + learnStage + ' 课完成！') : ('第 ' + level + ' 课完成！')}}</view>
    <view class="result-sub">{{learnMode ? (learnName + ' · 第 ' + learnIndex + ' / ' + learnTotal + ' 课 · 学习得分 ' + score) : ('共消除 ' + pairs + ' 对 · 学习得分 ' + score + ' · 连续正确 ×' + combo)}}</view>
    <view class="result-acc {{clean ? 'ok' : ''}}">
      本课正确率 {{learnMode ? learnAcc : accuracy}}% {{clean ? '· 全程无失误 ✦' : ''}}<text wx:if="{{learnMode && learnStepsBudget}}"> · 用了 {{learnStepsUsed}} / {{learnStepsBudget}} 步</text>
    </view>
    <!-- PRD v4：本关星级评价（只增不减；学习线为当场展示，不落库） -->
    <view class="result-stars">
      <text class="rs-star {{item}}" wx:for="{{starList}}" wx:key="*this">★</text>
      <text class="rs-tip">{{starsImproved ? '刷新了本课最佳评价' : '本课评价'}}</text>
    </view>
  </view>

  <!-- D113 来自朋友的挑战：B 打完这一课，先看到与 TA 的对比，再决定送不送祝福。
       入口**只挂在分享卡上**（?to= 匿名 uid）—— 自己玩自己的关卡时这里整块不出现，
       这样打赏永远是「朋友之间」的事，也不会变成常驻的消费入口。 -->
  <view wx:if="{{toUid && !isSelf}}" class="chal-card">
    <view class="chal-tag">来自朋友的一课</view>
    <view wx:if="{{chSteps}}" class="chal-line">
      TA 用了 {{chSteps}} 步<text wx:if="{{mySteps}}"> · 你用了 {{mySteps}} 步</text>
    </view>
    <view wx:if="{{beatText}}" class="chal-beat">{{beatText}}</view>
    <button class="chal-btn" bindtap="goGift">送一份祝福给 TA →</button>
  </view>

  <!-- D111 学习体系：本级进度 + 下一课预告（学习线专属，老线不渲染） -->
  <view wx:if="{{learnMode}}" class="learn-progress">
    <view class="lp-head">
      <text class="lp-tag">学习体系</text>
      <text class="lp-lv">L{{learnLv}} · {{learnName}}</text>
    </view>
    <view class="lp-goal">{{learnGoal}}</view>
    <view class="lp-bar"><view class="lp-bar-in" style="width: {{learnDoneN * 10}}%;"></view></view>
    <view class="lp-note">本级进度 {{learnDoneN}} / 10 课<text wx:if="{{learnDoneN >= 10}}"> · 本级已完成</text> · 已获证书 {{learnCertOwned}} / 15</view>
    <view class="lp-note lp-next">{{learnNextDesc}}</view>
  </view>

  <!-- D111 本级证书（一整级 10 课全过才颁发；只升不降） -->
  <view wx:if="{{learnMode && learnCert}}" class="cert-banner" style="border-color: {{learnCert.tierColor}};">
    <view class="cert-seal" style="background: {{learnCert.tierColor}};">{{learnCert.tierSeal}}</view>
    <view class="cert-info">
      <view class="cert-line">{{learnCertNew ? '获得藏文拼读证书' : (learnCertUpgraded ? '证书升级' : '本级证书')}} · {{learnCert.tierLabel}}</view>
      <view class="cert-line2">L{{learnCert.lv}} · {{learnCert.name}} · 正确率 {{learnCert.acc}}%</view>
    </view>
    <view class="cert-go" bindtap="openLearnCert">查看 ›</view>
  </view>

  <!-- PRD v4：唐卡碎片掉落 + 学习得分入账 -->
  <view class="reward-row">
    <view class="reward-box">
      <view class="rw-v">+{{pointsGained}}</view>
      <view class="rw-k">学习得分入账</view>
    </view>
    <view class="reward-box">
      <view class="rw-v">{{fragmentNew ? ('第 ' + fragmentNew + ' 片') : '已集齐'}}</view>
      <view class="rw-k">{{fragmentDone ? '唐卡已拼成' : ('唐卡碎片 ' + fragmentCount + '/9')}}</view>
    </view>
  </view>

  <!-- 秘境揭图揭晓（D31）：通关即整幅揭晓，图收入护照「揭示图鉴」 -->
  <view wx:if="{{reveal && !learnMode}}" class="reveal-card">
    <view class="reveal-head">
      <text class="reveal-tag">秘境图揭晓</text>
      <text class="reveal-name">{{reveal.name}}</text>
    </view>
    <image class="reveal-art" src="{{reveal.img}}" mode="widthFix" />
    <view class="reveal-tib">
      <text class="rt-t tibetan">{{reveal.tibetan}}</text>
      <text class="rt-roman">{{reveal.roman}}</text>
    </view>
    <view class="reveal-desc">{{reveal.desc}}</view>
    <view class="reveal-note">已收入文化护照 · 揭示图鉴 {{revealGot}} / {{revealTotal}}</view>
  </view>

  <!-- 藏地密码：完成即解锁一则藏地小知识，收入护照「藏地密码」。
       解锁状态 = completedLevels（不新增存储字段），与揭示图鉴同一口径。 -->
  <view wx:if="{{secret && !learnMode}}" class="secret-card">
    <view class="secret-head">
      <text class="secret-tag">藏地密码</text>
      <text class="secret-kind">{{secret.tag}}</text>
    </view>
    <view class="secret-title">{{secret.title}}</view>
    <view class="secret-text">{{secret.text}}</view>
    <view class="secret-listen" bindtap="speakSecret">🔊 听讲解（中文语音）</view>
    <view class="secret-note">已收入文化护照 · 藏地密码 {{secretGot}} / {{secretTotal}}</view>
  </view>

  <!-- 前 60 秒钩子：在「要不要再来一关」的决策点上摆出进度与悬念 -->
  <view class="journey">
    <view class="j-head">
      <text class="j-step">第 {{level}} / {{totalLevels}} 课</text>
      <text class="j-day">旅行第 {{journeyDay}} 天</text>
    </view>
    <view class="j-bar"><view class="j-bar-in" style="width: {{cardPercent}}%;"></view></view>
    <view class="j-slots">
      <view
        wx:for="{{cardSlots}}"
        wx:key="id"
        class="j-slot {{item.got ? 'got' : ''}}"
        style="{{item.got ? ('border-color:' + item.color + ';') : ''}}"
      >
        <text wx:if="{{item.got && item.isLetter}}" class="j-glyph tibetan" style="color: {{item.color}};">{{item.label}}</text>
        <text wx:if="{{item.got && !item.isLetter}}" class="j-glyph" style="color: {{item.color}};">{{item.label}}</text>
        <text wx:if="{{!item.got}}" class="j-glyph j-unknown">?</text>
      </view>
    </view>
    <view class="j-note">已认识 {{cardGot}} / {{cardTotal}} 个藏文字母与文化元素{{cardLeft ? ('，还有 ' + cardLeft + ' 个在前面等你遇见。') : '，已全部收藏。'}}</view>
  </view>

  <!-- 「藏文可以组合」预告：只在第 2 关的结算页出现（该关通关即认全 ཀ ཁ ག ང）。
       用「两个完整音节的对比」讲拼合，绝不裸渲染元音符号（否则会落成 ◌ི 虚圈，
       违反 docs/tibetan-typography.md 的「绝不拆音节」）。文案取自 data/combo.js。 -->
  <view wx:if="{{comboTease && !learnMode}}" class="combo-tease">
    <view class="ct-head">
      <text class="ct-tag">{{comboTease.tag}}</text>
    </view>
    <view class="ct-demo">
      <text class="ct-glyph tibetan">{{comboTease.base}}</text>
      <text class="ct-arrow">→</text>
      <text class="ct-glyph tibetan ct-on">{{comboTease.combined}}</text>
      <text class="ct-roman">{{comboTease.roman}}</text>
    </view>
    <text class="ct-hint">{{comboTease.hint}}</text>
    <text class="ct-note">{{comboTease.note}}</text>
  </view>

  <!-- 成长阶梯 · 证书（完成某阶段最后一关时颁发 / 升级） -->
  <view wx:if="{{cert && !learnMode}}" class="cert-banner" style="border-color: {{cert.tierColor}};">
    <view class="cert-seal" style="background: {{cert.tierColor}};">{{cert.tierSeal}}</view>
    <view class="cert-info">
      <view class="cert-line">{{certTitle}} · {{cert.tierLabel}}</view>
      <view class="cert-line2">第 {{cert.stage}} 阶段 · {{cert.stageName}} · 正确率 {{cert.acc}}%</view>
    </view>
    <view class="cert-go" bindtap="openCert">查看 ›</view>
  </view>

  <!-- 尚未拿到证书时，显示阶段进度与「还差什么」的牵引 -->
  <view wx:if="{{!cert && !learnMode && stageNo}}" class="cert-hint">
    <text>第 {{stageNo}} 阶段 · {{stageName}}</text>
    <text wx:if="{{skillHint}}" class="cert-hint-skill">{{skillHint}}</text>
  </view>

  <!-- 阶段完结时的「下一步」预告（D27）。
       12 阶段路线图此前只在证书页可见，而「要不要继续」的决定发生在这里。
       阶段名与目标全部取自 data/stages.js，页面不写死。 -->
  <view wx:if="{{cert && !learnMode && nextStageNo}}" class="next-stage">
    <view class="ns-head">
      <text class="ns-tag">下一阶段</text>
      <text class="ns-name">第 {{nextStageNo}} 阶段 · {{nextStageName}}</text>
    </view>
    <text class="ns-goal">下一步：{{nextStageGoal}}</text>
    <text class="ns-note">{{nextStageOpen ? ('已开放 · 第 ' + nextStageRange + ' 课') : ('内容制作中 · 规划第 ' + nextStageRange + ' 课')}}</text>
  </view>

  <!-- 文化护照印记 v0 -->
  <view wx:if="{{newStamp && !learnMode}}" class="stamp-banner">
    <view class="stamp-seal">拉萨</view>
    <view class="stamp-text">
      <text class="stamp-title">获得文化护照印记</text>
      <text class="stamp-sub">西藏文化护照 · 已收集 {{stampCount}} / {{stampTotal}} 枚印章</text>
    </view>
  </view>

  <view class="section" wx:if="{{collected.length}}">
    <view class="section-title">本课收集的文化卡（{{collected.length}} 张）</view>
    <view class="chips">
      <view wx:for="{{collected}}" wx:key="id" class="chip" style="border-color: {{item.color}};">
        <text wx:if="{{item.isLetter}}" class="chip-glyph tibetan" style="color: {{item.color}};">{{item.label}}</text>        <text wx:else class="chip-glyph" style="color: {{item.color}};">{{item.label}}</text>
        <text class="chip-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 祝福卡（仅第10关） -->
  <block wx:if="{{isFinal}}">
    <view class="bless-section" wx:if="{{!imagePath}}">
      <view class="bless-title">🎉 扎西德勒！完成全部10课</view>
      <view class="bless-sub">生成你的专属扎西德勒祝福卡，分享给朋友吧</view>
      <button class="primary-btn" bindtap="openNameModal" disabled="{{generating}}">
        {{generating ? '生成中…' : '生成我的祝福卡'}}
      </button>
    </view>

    <view class="bless-section" wx:if="{{imagePath}}">
      <image class="bless-img" src="{{imagePath}}" mode="widthFix" />
      <view class="btn-row">
        <button class="half-btn ghost" bindtap="previewShare">预览 / 长按转发</button>
        <button class="half-btn" bindtap="saveToAlbum">保存到相册</button>
      </view>
      <button class="share-btn" open-type="share">分享给朋友</button>
    </view>
  </block>

  <!-- 固定底栏（首屏可达）：主操作永远在手边。
       此前这三个按钮排在长内容之后，实测「下一课」落在折线下 622px（普通关）/ 972px（第 10 关），
       玩完一关要继续得先滑一屏——本条把主操作钉在屏幕上，内容照旧可滚（下内边距由 .page.has-bar 让位）。 -->
  <view class="result-bar">
    <block wx:if="{{learnMode}}">
      <button class="next-btn" bindtap="goNextLearn">{{learnNextLabel}}</button>
    </block>
    <block wx:elif="{{!isFinal}}">
      <button class="next-btn" bindtap="goNext">下一课 →</button>
    </block>
    <block wx:else>
      <button wx:if="{{!imagePath}}" class="next-btn" bindtap="openNameModal" disabled="{{generating}}">{{generating ? '生成中…' : '生成我的祝福卡'}}</button>
      <button wx:else class="next-btn" open-type="share">分享给朋友</button>
    </block>
    <view class="bar-links">
      <button class="passport-btn" bindtap="openPassport">文化护照 · {{ownedCerts}} 张证书</button>
      <button class="home-btn" bindtap="goHome">返回首页</button>
    </view>
  </view>

  <!-- 昵称输入弹窗 -->
  <view wx:if="{{showNameModal}}" class="mask" bindtap="closeNameModal">
    <view class="modal" catchtap="noop">
      <view class="modal-title">留下你的名字</view>
      <view class="modal-sub">将出现在祝福卡上（最多10个字）</view>
      <input
        class="name-input"
        value="{{nameInput}}"
        maxlength="10"
        placeholder="朋友"
        placeholder-class="name-placeholder"
        focus
        bindinput="onNameInput"
      />
      <view class="modal-btns">
        <button class="modal-btn ghost" bindtap="closeNameModal">取消</button>
        <button class="modal-btn solid" bindtap="confirmGenerate">生成祝福卡</button>
      </view>
    </view>
  </view>

  <view class="roller roller-bottom" aria-hidden="true"></view>
  </view>
</view>
