/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 50rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.result-hero {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.result-check {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #1E8449;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 700;
}

.result-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #2C3E50;
}

.result-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #8A8375;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #E4DCC8;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B6455;
  margin-bottom: 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E4DCC8;
  background: #FDF6E3;
}

.chip-glyph {
  font-size: 36rpx;
  font-weight: 600;
}

.chip-name {
  font-size: 24rpx;
  color: #6B6455;
}

/* 祝福卡区块 */
.bless-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
  border: 2rpx solid #E4DCC8;
}

.bless-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #C0392B;
}

.bless-sub {
  margin: 16rpx 0 30rpx;
  font-size: 26rpx;
  color: #8A8375;
}

.bless-img {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(62, 58, 51, 0.2);
}

.primary-btn {
  background: #C0392B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.half-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #C0392B;
  color: #FFFFFF;
  padding: 0;
}

.half-btn.ghost {
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

.share-btn {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #1E8449;
  color: #FFFFFF;
}

.home-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 34, 24, 0.5);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
}

.modal-sub {
  text-align: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8375;
}

.name-input {
  margin-top: 30rpx;
  height: 88rpx;
  border: 2rpx solid #E4DCC8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.name-placeholder {
  color: #B9B1A0;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
}

.modal-btn.ghost {
  background: #F3EFE3;
  color: #6B6455;
}

.modal-btn.solid {
  background: #C0392B;
  color: #FFFFFF;
}
