/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 50rpx 40rpx 80rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #FDF6E3 0%, #FAF0DA 52%, #F2E4C6 100%);
}

/* ============ 藏文化背景层（与首页/游戏页统一） ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.85;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.92;
}
.content {
  position: relative;
  z-index: 1;
}

.result-hero {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.result-check {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #1E8449;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 700;
}

.result-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #2C3E50;
}

.result-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #8A8375;
}

/* 文化护照印记 v0 */
.stamp-banner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(96, 78, 44, 0.12);
}

.stamp-seal {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: 4rpx solid #C0392B;
  border-radius: 16rpx;
  color: #C0392B;
  font-size: 34rpx;
  font-weight: 700;
  transform: rotate(-6deg);
  background: #FDF6E3;
  flex-shrink: 0;
}

.stamp-text {
  margin-left: 26rpx;
  display: flex;
  flex-direction: column;
}

.stamp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
}

.stamp-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A8375;
}

/* 下一关 */
.next-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-bottom: 20rpx;
}

.section {
  background: rgba(255, 255, 255, 0.88);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(96, 78, 44, 0.12);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B6455;
  margin-bottom: 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E4DCC8;
  background: #FDF6E3;
}

.chip-glyph {
  font-size: 36rpx;
  font-weight: 600;
}

.chip-name {
  font-size: 24rpx;
  color: #6B6455;
}

/* 祝福卡区块 */
.bless-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
  border: 2rpx solid #E4DCC8;
}

.bless-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #C0392B;
}

.bless-sub {
  margin: 16rpx 0 30rpx;
  font-size: 26rpx;
  color: #8A8375;
}

.bless-img {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(62, 58, 51, 0.2);
}

.primary-btn {
  background: #C0392B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.half-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #C0392B;
  color: #FFFFFF;
  padding: 0;
}

.half-btn.ghost {
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

.share-btn {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #1E8449;
  color: #FFFFFF;
}

.home-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 34, 24, 0.5);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
}

.modal-sub {
  text-align: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8375;
}

.name-input {
  margin-top: 30rpx;
  height: 88rpx;
  border: 2rpx solid #E4DCC8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.name-placeholder {
  color: #B9B1A0;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
}

.modal-btn.ghost {
  background: #F3EFE3;
  color: #6B6455;
}

.modal-btn.solid {
  background: #C0392B;
  color: #FFFFFF;
}

/* ============ 成长阶梯 · 证书 ============ */
.result-acc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8A8375;
}

.result-acc.ok {
  color: #B7950B;
  font-weight: 600;
}

.cert-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFFBF0 0%, #FFFFFF 100%);
  border: 3rpx solid #C0392B;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(96, 78, 44, 0.16);
}

.cert-seal {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(96, 78, 44, 0.22);
}

.cert-info {
  flex: 1;
  margin-left: 24rpx;
}

.cert-line {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
}

.cert-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A8375;
}

.cert-go {
  font-size: 28rpx;
  font-weight: 700;
  color: #C0392B;
  flex-shrink: 0;
}

.cert-hint {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: #6B6455;
}

.cert-hint-skill {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B7950B;
}

.passport-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #1E8449;
  border: 2rpx solid #1E8449;
  box-sizing: border-box;
}

/* ============ 唐卡画卷展开（PRD 4.2 结算弹窗） ============ */
/* 画卷自上而下缓缓展开；上下两根木质卷轴杆随画展开 */
.content.unfurl {
  transform-origin: 50% 0;
  animation: unfurl 0.9s cubic-bezier(0.18, 0.7, 0.3, 1) both;
}
@keyframes unfurl {
  0%   { opacity: 0; transform: scaleY(0.06); }
  40%  { opacity: 1; }
  70%  { transform: scaleY(1.015); }
  100% { opacity: 1; transform: scaleY(1); }
}
.roller {
  position: absolute;
  left: 4%;
  right: 4%;
  height: 22rpx;
  border-radius: 11rpx;
  background: linear-gradient(180deg, #9C7A4B 0%, #6B4A26 55%, #4A3218 100%);
  box-shadow: 0 6rpx 14rpx rgba(74, 50, 24, 0.38);
  z-index: 5;
}
.roller-top {
  top: -12rpx;
}
.roller-bottom {
  bottom: -12rpx;
}
.roller::before,
.roller::after {
  content: '';
  position: absolute;
  top: -8rpx;
  width: 26rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #B7950B, #8A6D08);
  box-shadow: 0 4rpx 10rpx rgba(74, 50, 24, 0.4);
}
.roller::before { left: -14rpx; }
.roller::after { right: -14rpx; }
