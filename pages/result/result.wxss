/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 50rpx 40rpx 80rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #451510 0%, #2E1220 26%, #101F38 62%, #0B1E36 100%);
}

/* ============ 藏文化背景层（与首页/游戏页统一） ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-bg {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.16;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.14;
}

/* 夜色罩：压暗四角、突出中心金光，保证前景可读（禁止大白板） */
.sc-night {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 32%,
    rgba(255, 214, 140, 0.08) 0%,
    rgba(16, 22, 42, 0.42) 46%,
    rgba(5, 8, 18, 0.8) 100%);
}
.content {
  position: relative;
  z-index: 1;
}

.result-hero {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.result-check {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #1E8449;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 700;
}

.result-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #F5E9CF;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.55);
}

.result-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #C9BFA8;
}

/* 文化护照印记 v0 */
.stamp-banner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(96, 78, 44, 0.12);
}

.stamp-seal {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: 4rpx solid #C0392B;
  border-radius: 16rpx;
  color: #C0392B;
  font-size: 34rpx;
  font-weight: 700;
  transform: rotate(-6deg);
  background: #FDF6E3;
  flex-shrink: 0;
}

.stamp-text {
  margin-left: 26rpx;
  display: flex;
  flex-direction: column;
}

.stamp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
}

.stamp-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A8375;
}

/* 下一关 */
.next-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-bottom: 20rpx;
}

.section {
  background: rgba(255, 255, 255, 0.88);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(96, 78, 44, 0.12);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B6455;
  margin-bottom: 20rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E4DCC8;
  background: #FDF6E3;
}

.chip-glyph {
  font-size: 36rpx;
  font-weight: 600;
}

.chip-name {
  font-size: 24rpx;
  color: #6B6455;
}

/* 祝福卡区块 */
.bless-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
  border: 2rpx solid #E4DCC8;
}

.bless-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #C0392B;
}

.bless-sub {
  margin: 16rpx 0 30rpx;
  font-size: 26rpx;
  color: #8A8375;
}

.bless-img {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(62, 58, 51, 0.2);
}

.primary-btn {
  background: #C0392B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.half-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #C0392B;
  color: #FFFFFF;
  padding: 0;
}

.half-btn.ghost {
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

.share-btn {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #1E8449;
  color: #FFFFFF;
}

.home-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 34, 24, 0.5);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
}

.modal-sub {
  text-align: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8375;
}

.name-input {
  margin-top: 30rpx;
  height: 88rpx;
  border: 2rpx solid #E4DCC8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.name-placeholder {
  color: #B9B1A0;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
}

.modal-btn.ghost {
  background: #F3EFE3;
  color: #6B6455;
}

.modal-btn.solid {
  background: #C0392B;
  color: #FFFFFF;
}

/* ============ 成长阶梯 · 证书 ============ */
.result-acc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #C9BFA8;
}

.result-acc.ok {
  color: #B7950B;
  font-weight: 600;
}

.cert-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFFBF0 0%, #FFFFFF 100%);
  border: 3rpx solid #C0392B;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(96, 78, 44, 0.16);
}

.cert-seal {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(96, 78, 44, 0.22);
}

.cert-info {
  flex: 1;
  margin-left: 24rpx;
}

.cert-line {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
}

.cert-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A8375;
}

.cert-go {
  font-size: 28rpx;
  font-weight: 700;
  color: #C0392B;
  flex-shrink: 0;
}

.cert-hint {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: #6B6455;
}

.cert-hint-skill {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B7950B;
}

.passport-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #1E8449;
  border: 2rpx solid #1E8449;
  box-sizing: border-box;
}

/* ============ 唐卡画卷展开（PRD 4.2 结算弹窗） ============ */
/* 画卷自上而下缓缓展开；上下两根木质卷轴杆随画展开 */
.content.unfurl {
  transform-origin: 50% 0;
  animation: unfurl 0.9s cubic-bezier(0.18, 0.7, 0.3, 1) both;
}
@keyframes unfurl {
  0%   { opacity: 0; transform: scaleY(0.06); }
  40%  { opacity: 1; }
  70%  { transform: scaleY(1.015); }
  100% { opacity: 1; transform: scaleY(1); }
}
.roller {
  position: absolute;
  left: 4%;
  right: 4%;
  height: 22rpx;
  border-radius: 11rpx;
  background: linear-gradient(180deg, #9C7A4B 0%, #6B4A26 55%, #4A3218 100%);
  box-shadow: 0 6rpx 14rpx rgba(74, 50, 24, 0.38);
  z-index: 5;
}
.roller-top {
  top: -12rpx;
}
.roller-bottom {
  bottom: -12rpx;
}
.roller::before,
.roller::after {
  content: '';
  position: absolute;
  top: -8rpx;
  width: 26rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #B7950B, #8A6D08);
  box-shadow: 0 4rpx 10rpx rgba(74, 50, 24, 0.4);
}
.roller::before { left: -14rpx; }
.roller::after { right: -14rpx; }

/* ============ PRD v4：本关星级 / 积分与唐卡碎片奖励 ============ */
.result-stars {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.rs-star { font-size: 44rpx; color: #DDD3BC; line-height: 1; }
.rs-star.on { color: #F1C40F; text-shadow: 0 2rpx 6rpx rgba(183, 149, 11, 0.5); }
.rs-tip { margin-left: 10rpx; font-size: 20rpx; color: #B9AE94; }

.reward-row { display: flex; gap: 16rpx; margin: 18rpx 0 6rpx; }
.reward-box {
  flex: 1;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(214, 202, 176, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(96, 78, 44, 0.12);
  text-align: center;
}
.rw-v { font-size: 34rpx; font-weight: 700; color: #C0392B; }
.rw-k { margin-top: 6rpx; font-size: 20rpx; color: #8A8375; }

/* ============ 前 60 秒钩子：结算决策点上的进度锚 ============ */
.journey {
  margin: 18rpx 0 6rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(214, 202, 176, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(96, 78, 44, 0.12);
}
.j-head { display: flex; align-items: baseline; justify-content: space-between; }
.j-step { font-size: 24rpx; font-weight: 700; color: #2C3E50; }
.j-day { font-size: 20rpx; color: #8A8375; }
.j-bar {
  margin-top: 14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(214, 202, 176, 0.6);
  overflow: hidden;
}
.j-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #C0392B, #B7950B);
}
.j-slots { display: flex; gap: 8rpx; margin-top: 16rpx; }
.j-slot {
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 10rpx;
  border: 1rpx dashed rgba(178, 166, 140, 0.9);
  background: rgba(253, 246, 227, 0.7);
}
.j-slot.got {
  border-style: solid;
  background: rgba(255, 255, 255, 0.98);
}
.j-glyph { font-size: 26rpx; font-weight: 700; }
.j-unknown { color: #C4BCA6; font-weight: 400; }
.j-note { margin-top: 14rpx; font-size: 20rpx; line-height: 1.6; color: #8A8375; }

/* ============ D27：阶段完结后的「下一步」预告 ============ */
.next-stage {
  display: flex;
  flex-direction: column;
  margin: 14rpx 0 6rpx;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx dashed rgba(183, 149, 11, 0.75);
}
.ns-head {
  display: flex;
  align-items: baseline;
}
.ns-tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FFFBF0;
  background: #B7950B;
}
.ns-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2C3E50;
}
.ns-goal {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #2C3E50;
}
.ns-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A8375;
}

/* ============ 「藏文可以组合」拼合预告（仅第 2 关结算页） ============ */
/* 用「两个完整音节的对比」讲拼合：ཀ → ཀི。
   元音只在「与基字同簇」的形态里出现，避免 ◌ི 虚圈。 */
.combo-tease {
  display: flex;
  flex-direction: column;
  margin: 18rpx 0 6rpx;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(36, 113, 163, 0.5);
}
.ct-head { display: flex; align-items: baseline; }
.ct-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FFFBF0;
  background: #2471A3;
}
.ct-demo {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}
.ct-glyph {
  font-size: 52rpx;
  font-weight: 700;
  color: #2C3E50;
}
.ct-on { color: #1F4E79; }
.ct-arrow {
  margin: 0 16rpx;
  font-size: 28rpx;
  color: #8A8375;
}
.ct-roman {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8A8375;
}
.ct-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #2C3E50;
}
.ct-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #8A8375;
}
