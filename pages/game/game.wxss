/* pages/game/game.wxss */
.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
  position: relative;
}

/* ============ 藏文化背景层 ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
/* 真实场景照片层（D47）：铺满页面，位于底图之上、纹样/剪影/色罩之下。
   照片的「去艳与压暗」在 scripts/prepare-assets.py --scene 加工时烘进图里，
   运行时再叠既有夜色罩（.sc-night），不需要 CSS filter（真机兼容更稳）。 */
.sc-photo {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
  object-fit: cover;
}

.sc-bg {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 30rpx; /* 砖为 2:1，方框会纵向拉伸两倍（D39 修正） */
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.16;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.14;
}

/* 页面背景（兜底，被底图覆盖）：全局暗色舞台 */
.page {
  background: linear-gradient(180deg, #451510 0%, #2E1220 26%, #101F38 62%, #0B1E36 100%);
}

/* 夜色罩：把藏式纹样/雪山压暗，突出前方棋盘（禁止大白板） */
.sc-night {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 30%,
    rgba(255, 214, 140, 0.10) 0%,
    rgba(11, 30, 54, 0.55) 46%,
    rgba(6, 14, 26, 0.82) 100%);
}

.statusbar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* 换行兜底：窄屏（375px 实测）上 5 个分项 + 长昵称分数会挤爆一行，
     允许换行比裁切或缩小字号更稳（每个分项 margin 4rpx 防止两行贴在一起） */
  flex-wrap: wrap;
  padding: 14rpx 22rpx;
  margin-bottom: 14rpx;
  font-size: 29rpx;
  background: linear-gradient(180deg, rgba(33, 58, 92, 0.92), rgba(18, 36, 62, 0.92));
  border: 1rpx solid rgba(183, 149, 11, 0.42);
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.45);
  color: #EAF2FA;
}

.statusbar > text {
  margin: 4rpx 0;
}

.status-level {
  font-weight: 700;
  color: #FFD98A;
  /* nowrap：flex 行内被挤压时「第 N 课」会在两个字之间断行（实测窄屏复现） */
  white-space: nowrap;
}

.status-pairs {
  color: #B9C7D6;
  white-space: nowrap;
}

.status-score {
  color: #FFD98A;
  font-weight: 700;
}
/* 文案开关（D34）：只关赞美文案，不关元素发音（发音属学习闭环）。
   「关」态靠虚线边框 + 降透明度区分，不引入新的字色。 */
.status-praise {
  font-size: 24rpx;
  padding: 3rpx 12rpx;
  border: 1rpx solid rgba(183, 149, 11, 0.65);
  border-radius: 20rpx;
  color: #B9C7D6;
}
.status-praise.off {
  border-style: dashed;
  opacity: 0.72;
}
/* 背景音乐开关（PRD 3.3）：沿用同一个开关样式，只补一点与文案开关的间距 */
.status-bgm { margin-left: 10rpx; }

/* ============ 盘面：四层物理层次（背景 → 底盘 → 槽位 → 方块） ============ */
.game-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 560rpx;
}

/* 第二层：暗金浮雕底盘（金色渐变 + 厚重外阴影），从夜色光晕中浮起 */
/* 分隔感三件套：① 深色描边外圈 ② 厚重外阴影（含投影偏移，产生"悬空"）③ 内圈凹槽下沉 */
.board-panel {
  background:
    linear-gradient(158deg, #8A6D1E 0%, #6E5416 26%, #4A3810 62%, #2E2209 100%);
  border: 3rpx solid rgba(232, 200, 107, 0.5);
  border-radius: 34rpx;
  padding: 20rpx;
  box-shadow:
    0 2rpx 0 rgba(255, 240, 200, 0.30) inset,
    0 -4rpx 10rpx rgba(0, 0, 0, 0.5) inset,
    0 10rpx 0 rgba(0, 0, 0, 0.32),
    0 30rpx 60rpx rgba(0, 0, 0, 0.72),
    0 0 66rpx rgba(232, 200, 107, 0.20);
}

/* 底盘内圈：下沉的凹槽区（深色 + 内阴影，与金边形成高差分界） */
.board-outline {
  background: linear-gradient(180deg, #0A1626 0%, #060E1A 100%);
  border: 2rpx solid rgba(232, 200, 107, 0.26);
  border-radius: 24rpx;
  padding: 12rpx;
  box-shadow:
    inset 0 8rpx 18rpx rgba(0, 0, 0, 0.82),
    inset 0 -2rpx 0 rgba(232, 200, 107, 0.14);
}

/* D33：盘面不再是 CSS grid 自动流 —— 方块绝对定位，坐标由 transform: translate(%, %)
   给出（百分比相对元素自身，所以不必在 transform 里写 rpx 单位）。
   下落 = 同一个节点的 ty 变化，由 .tile 的 transition 平滑过渡。 */
.board {
  position: relative;
  margin: 0 auto;
  z-index: 1;
}

/* 秘境揭图（D31）：垫在牌层之下的整幅图，某格清空过就永久透出。
   ⚠️ 必须用 <image> 组件（WXSS background-image 引本地路径真机不可靠），尺寸由 JS 精确对齐牌区。
   overflow:hidden 让补充牌在盘外上方时被裁掉，像从边框里滑出来。 */
.board-wrap {
  position: relative;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 16rpx;
}

.reveal-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  pointer-events: none;
}

/* 揭图进度：只报百分比不剧透名字，压在暗金底盘内 */
.reveal-cap {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #C9BFA8;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.6);
}

/* 第三层：槽位 + 方块（D33 起二合一，绝对定位、按牌 uid 稳定 key）。
   槽位凹陷感来自 inset 内阴影；牌层由内层 .piece 提供 3D 凸起。
   transition 的 cubic-bezier 带轻微过冲（1.16）= 下落到位时的「弹一下」。
   ⚠️ 用 left/top 之外的属性都要小心单位；这里只动 transform，位置用 translate(%) 表达。 */
.tile {
  position: absolute;
  left: 0;
  top: 0;
  background: #0D2137;
  border: none;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: inset 0 5rpx 9rpx rgba(0, 0, 0, 0.72);
  overflow: visible;
  transition: transform 300ms cubic-bezier(0.34, 1.16, 0.64, 1), opacity 180ms ease;
  will-change: transform;
}

/* 补充牌首帧：停在盘外上方（ty 已减去下落格数）且透明，下一帧落到位置 → 「从顶上掉下来」 */
.tile.fresh {
  opacity: 0;
}

/* 第四层：凸起方块——渐变底色 + 底部厚重投影 + 顶部高光（3D 凸出感） */
.piece {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  overflow: hidden;
}

/* 藏文字母：暖金色浮雕字，居中、字号为格子 60%（由 JS 传入） */
.glyph {
  font-weight: 600;
  line-height: 1;
  color: #FFF6DC;
  text-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.45), 0 -1rpx 0 rgba(255, 255, 255, 0.42);
  transform: translateY(-2%);
}

.glyph-img {
  width: 72%;
  height: 72%;
  filter: drop-shadow(0 3rpx 3rpx rgba(0, 0, 0, 0.42));
}

.glyph-fallback {
  font-size: 30rpx !important;
  font-weight: 700;
  color: #FFF6DC;
  text-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.45);
}

/* 精灵表字母（试点 ཀ）：全部该字母方块共用 images/sprite_ka.png 一张图（1 次图片请求），
   2×2 四色帧（红/蓝/绿/黄）用帧位移切换；质感（左上光源/软糖材质/底部暗色）已烘在帧里。
   注：WXSS 的 background-image url() 引用本地路径在真机不可靠，故用 <image> 组件 + 容器位移切帧（机制等价）。 */
.piece.ka-sprite-piece {
  box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.4);
}
.ka-sprite {
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 牌面高 1.2×宽，精灵帧取正方形居中，避免拉伸变形 */
  transform: translateY(-50%);
  overflow: hidden;
  border-radius: 12rpx;
  pointer-events: none;
}
.ka-sprite image {
  position: absolute;
  left: 0;
  top: 0;
  width: 200%;   /* 2×2 精灵表：单帧 = 容器 200% 尺寸的一半 */
  height: 200%;
  max-width: none;
}
.ka-v1 image { left: -100%; }
.ka-v2 image { top: -100%; }
.ka-v3 image { left: -100%; top: -100%; }
/* 金色特殊方块：保留精灵质感，提亮 + 金星标记 */
.tile.golden .piece.ka-sprite-piece {
  background-image: none !important;
  box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.4), 0 0 16rpx rgba(255, 217, 138, 0.55) !important;
}
.tile.golden .ka-sprite image {
  filter: saturate(1.2) brightness(1.14);
}
/* D32 对比度：金块牌面是浅金（#FFF6D8→#FFE9A8→#E8C465），奶白字形会掉到 1.00，
   必须换深墨（#6B4406 = 7.91 / 7.12 / 5.10）；图标用 |gold 变体同墨。 */
.tile.golden .glyph,
.tile.golden .glyph-fallback {
  color: #6B4406;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.55);
}

/* 障碍物一：冰霜——半透明蓝罩 + 白边高光，罩住的牌不能直接点 */
.frost {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 12rpx;
  background: linear-gradient(150deg, rgba(176, 226, 255, 0.62) 0%, rgba(88, 156, 214, 0.5) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 0 14rpx rgba(255, 255, 255, 0.68), 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.frost-mark {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 0 8rpx rgba(120, 190, 240, 0.9);
}

/* 障碍物二：藏式木箱——木纹底 + 金色剩余耐久 */
.crate {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 12rpx;
  background: linear-gradient(150deg, #7A4E24 0%, #6B431E 58%, #4A2C10 100%);
  border: 2rpx solid rgba(60, 34, 12, 0.9);
  box-shadow: inset 0 3rpx 0 rgba(255, 214, 140, 0.35), inset 0 -5rpx 10rpx rgba(0, 0, 0, 0.45), 0 3rpx 8rpx rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.crate-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFD98A;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.6);
}

/* 绳结（D40）：双股绳十字缠裹，深色底保证剩余股数的金字对比度达标（D32 同款深底 + #FFD98A） */
.rope {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 12rpx;
  background:
    linear-gradient(45deg, rgba(0, 0, 0, 0) 40%, #C08A4E 40%, #8A5A2B 50%, #C08A4E 60%, rgba(0, 0, 0, 0) 60%),
    linear-gradient(135deg, rgba(0, 0, 0, 0) 40%, #C08A4E 40%, #8A5A2B 50%, #C08A4E 60%, rgba(0, 0, 0, 0) 60%),
    rgba(48, 28, 10, 0.82);
  border: 2rpx solid rgba(96, 60, 24, 0.9);
  box-shadow: inset 0 3rpx 0 rgba(255, 220, 160, 0.30), inset 0 -5rpx 10rpx rgba(0, 0, 0, 0.40), 0 3rpx 8rpx rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.rope-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFD98A;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.7);
}

/* 选中态：槽位内圈金环 + 方块轻微抬起 */
.tile.selected {
  box-shadow: inset 0 0 0 4rpx rgba(255, 217, 138, 0.85), inset 0 5rpx 9rpx rgba(0, 0, 0, 0.6);
  z-index: 2;
}
.tile.selected .piece {
  transform: scale(1.07) translateY(-4rpx);
}

/* 障碍物罩住的牌：轻按下沉，点不动 */
.tile.blocked .piece {
  filter: saturate(0.6) brightness(0.78);
}

/* 消除：方块先向上浮起 10px（20rpx），再缩小+金粉破碎（不是简单淡出） */
.tile.removing .piece {
  animation: shatterUp 0.34s cubic-bezier(0.3, 0.9, 0.4, 1) forwards;
}
@keyframes shatterUp {
  0%   { transform: translateY(0) scale(1); opacity: 1; }
  38%  { transform: translateY(-20rpx) scale(1.1); opacity: 1; }
  100% { transform: translateY(-4rpx) scale(0.18); opacity: 0; }
}

/* 已消除：D33 起消除的牌直接从盘面移除（不再用 visibility 隐藏）——
   格子空出来就透出下层秘境图，这正是 D31 揭图要的效果 */

/* 破碎粒子：金粉 + 风马旗碎片（六向飞散） */
.bits {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  pointer-events: none;
}
.bit {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
  transform: translate(-50%, -50%);
  opacity: 0;
  animation: bitFly 0.46s ease-out forwards;
}
.bit.gold { background: #FFD98A; box-shadow: 0 0 8rpx rgba(255, 217, 138, 0.85); }
.bit.r { background: #C0392B; }
.bit.g { background: #1E8449; }
.bit.b { background: #2471A3; }
.bit.y { background: #B7950B; }
.bit.w { background: #FFFFFF; }
.bit.d0 { animation-name: bitFly0; }
.bit.d1 { animation-name: bitFly1; }
.bit.d2 { animation-name: bitFly2; }
.bit.d3 { animation-name: bitFly3; }
.bit.d4 { animation-name: bitFly4; }
.bit.d5 { animation-name: bitFly5; }
@keyframes bitFly0 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(-190%, -230%) scale(0.4); } }
@keyframes bitFly1 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(60%, -260%) scale(0.4); } }
@keyframes bitFly2 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(220%, -150%) scale(0.4); } }
@keyframes bitFly3 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(210%, 90%) scale(0.4); } }
@keyframes bitFly4 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(-40%, 180%) scale(0.4); } }
@keyframes bitFly5 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(1); } 100% { opacity: 0; transform: translate(-220%, 70%) scale(0.4); } }

/* 不匹配抖动
   ⚠️ 必须抖内层 .piece，不能抖 .tile —— .tile 的 transform 已被用作定位
      （translate(tx%, ty%)），animation 里的 transform 会把它整体覆盖掉，
      牌会瞬间跳到盘面左上角。 */
.tile.shake .piece {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-6rpx); }
}

/* 金色特殊方块：暖金渐变 + 金色投影 + 角标 */
.tile.golden .piece {
  background-image: linear-gradient(180deg, #FFF6D8 0%, #FFE9A8 58%, #E8C465 100%) !important;
  box-shadow: 0 6rpx 0 #B8892A, 0 10rpx 18rpx rgba(0, 0, 0, 0.45), inset 0 3rpx 8rpx rgba(255, 255, 255, 0.5) !important;
}

.gold-star {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  font-size: 24rpx;
  color: #8A6414;
  line-height: 1;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* ============ 即时应激励浮字（D34）============
   一次只显示一条，**新的替换旧的**（不排队、不叠加）。
   两套完全相同的动画（praisePopA / praisePopB）轮流用：WXSS 里同一个 animation-name
   不会重播，替换文案时必须换成另一个名字，否则第二条看不出在播放。
   ⚠️ 两套 keyframes 的内容必须**逐字一致**，只有名字不同。 */
.praise-fx {
  position: fixed;
  top: 196rpx;
  left: 50%;
  z-index: 9;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}
.praise-fx.ant-a { animation: praisePopA 1.2s ease forwards; }
.praise-fx.ant-b { animation: praisePopB 1.2s ease forwards; }
@keyframes praisePopA {
  0%   { opacity: 0; transform: translateX(-50%) scale(0.7) translateY(14rpx); }
  16%  { opacity: 1; transform: translateX(-50%) scale(1.06) translateY(0); }
  30%  { transform: translateX(-50%) scale(1); }
  78%  { opacity: 1; }
  100% { opacity: 0; transform: translateX(-50%) translateY(-28rpx); }
}
@keyframes praisePopB {
  0%   { opacity: 0; transform: translateX(-50%) scale(0.7) translateY(14rpx); }
  16%  { opacity: 1; transform: translateX(-50%) scale(1.06) translateY(0); }
  30%  { transform: translateX(-50%) scale(1); }
  78%  { opacity: 1; }
  100% { opacity: 0; transform: translateX(-50%) translateY(-28rpx); }
}
/* 档位跃迁（等级 4 起）的一次性光环：插在 WXML 上靠 praiseAnt 重新挂载来重播动画 */
.praise-burst {
  position: fixed;
  top: 196rpx;
  left: 50%;
  width: 130rpx;
  height: 130rpx;
  margin-left: -65rpx;
  margin-top: -22rpx;
  border: 2rpx solid rgba(255, 217, 138, 0.85);
  border-radius: 50%;
  z-index: 8;
  pointer-events: none;
  animation: praiseBurst 0.72s ease-out forwards;
}
@keyframes praiseBurst {
  0%   { opacity: 0.9; transform: scale(0.45); }
  100% { opacity: 0; transform: scale(2.7); }
}
/* 文字配色：只落暗底的元素才提亮（D32 铁律，别把 #2C3E50 全局换掉）。
   #FFD98A / #F5E9CF 对 #0B1E36 实测 12.40:1 / 13.92:1，由 validate §32.12 机械断言。 */
.praise-combo {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFD98A;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.75);
}
.praise-bo {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #FFD98A;
  text-shadow: 0 0 18rpx rgba(255, 217, 138, 0.75), 0 3rpx 10rpx rgba(0, 0, 0, 0.8);
}
.praise-zh {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #F5E9CF;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.8);
}
/* 等级越高越亮越大（同一套文字，靠档位类放大） */
.praise-fx.lv4 .praise-zh { font-size: 42rpx; }
.praise-fx.lv5 .praise-zh { font-size: 46rpx; color: #FFD98A; }
.praise-fx.lv5 .praise-bo {
  font-size: 64rpx;
  text-shadow: 0 0 26rpx rgba(255, 217, 138, 0.95), 0 0 46rpx rgba(255, 165, 0, 0.55), 0 3rpx 10rpx rgba(0, 0, 0, 0.8);
}

/* 破冰 / 破箱浮字 */
.break-fx {
  position: fixed;
  top: 300rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(36, 113, 163, 0.94);
  color: #FFF6DC;
  font-size: 32rpx;
  font-weight: 700;
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
  z-index: 9;
  animation: breakPop 1.1s ease forwards;
  pointer-events: none;
}

@keyframes breakPop {
  0%   { opacity: 0; transform: translateX(-50%) scale(0.7); }
  22%  { opacity: 1; transform: translateX(-50%) scale(1.1); }
  60%  { opacity: 1; transform: translateX(-50%) scale(1); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-30rpx) scale(1); }
}

/* ============ 重复匹配轻提示（非阻塞） ============ */
.toast {
  position: fixed;
  left: 50%;
  /* 底部安全区：全面屏上 60rpx 会落进 Home Indicator 条 */
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%) translateY(20rpx);
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(44, 62, 80, 0.92);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 12rpx 26rpx 12rpx 14rpx;
  font-size: 26rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease, transform 0.22s ease;
  z-index: 55;
  max-width: 86%;
  box-sizing: border-box;
}
.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.toast-glyph {
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  overflow: hidden;
}
.toast-glyph text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1;
}
.toast-icon {
  width: 34rpx;
  height: 34rpx;
}

/* ============ 文化卡（首次发现，非阻塞 + 自动收起） ============ */
.card-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  z-index: 50;
  overflow: hidden;
  /* 刘海屏 / 全面屏底部安全区（D42 生产加固）：卡片内容不被 Home Indicator 压住 */
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 40rpx rgba(60, 44, 16, 0.28);
}

.card-sheet.show {
  transform: translateY(0);
}

.card-hero {
  position: relative;
  padding: 26rpx 30rpx 22rpx;
  color: #FFFFFF;
  overflow: hidden;
}

/* 头图藏纹水印 */
.hero-pat {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('/images/pat-tile.png');
  background-size: 76rpx 76rpx;
  opacity: 0.2;
}

.card-hero > view { position: relative; }

.card-x {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 26rpx;
}

.card-orn-l, .card-orn-r {
  position: absolute;
  top: 30rpx;
  font-size: 26rpx;
  opacity: 0.75;
  color: #FFE9B8;
}
.card-orn-l { left: 26rpx; }
.card-orn-r { right: 88rpx; }

.card-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.card-medal {
  width: 112rpx;
  height: 112rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
  flex: 0 0 auto;
  overflow: hidden;
}

.card-medal-g {
  font-size: 66rpx;
  line-height: 1;
}

.card-medal-img {
  width: 74%;
  height: 74%;
}

.card-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.94;
}

.card-body {
  padding: 24rpx 30rpx 6rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #3D3A30;
  line-height: 1.72;
}

.card-fact {
  margin-top: 20rpx;
  background: #FBF4E2;
  border-left: 6rpx solid #B7950B;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}

.fact-label {
  display: inline-block;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #8A6A12;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-bottom: 10rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.fact-text {
  display: block;
  font-size: 26rpx;
  color: #5B5343;
  line-height: 1.7;
}

/* 倒计时进度条 */
.card-progress {
  height: 6rpx;
  background: rgba(0, 0, 0, 0.07);
  margin-top: 20rpx;
}

.card-bar {
  height: 100%;
  width: 100%;
}
.card-bar.run {
  animation: cardBar 5200ms linear forwards;
}
@keyframes cardBar {
  from { width: 100%; }
  to   { width: 0%; }
}

.card-hint {
  text-align: center;
  font-size: 24rpx;
  color: #6E6759;
  padding: 12rpx 0 16rpx;
}

/* 藏纸卷轴：顶部卷轴杆 + 喇叭 + 「知道了」（PRD 4.3 形态，保持不打断游戏） */
.scroll-rod {
  height: 14rpx;
  background: linear-gradient(180deg, #E8D9A8 0%, #B7950B 42%, #7A5F06 100%);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.35);
}

.card-speak {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #FBF4E2;
  border: 1rpx dashed rgba(183, 149, 11, 0.6);
}
/* 没有音源：如实标注「发音待录入」，不再假装能播（D57） */
.card-speak.no-voice {
  background: #F1EDE2;
  border-style: solid;
  border-color: rgba(122, 110, 88, 0.35);
  opacity: 0.9;
}
.card-speak.no-voice .speak-text { color: #7A6E58; }
/* 点了才发现没音：左右轻抖一下当作反馈（不用弹窗，不打断这一局） */
.card-speak.miss { animation: speakMiss 380ms ease-in-out; }
@keyframes speakMiss {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  45% { transform: translateX(9rpx); }
  70% { transform: translateX(-5rpx); }
}
.speak-icon { font-size: 30rpx; }
.speak-text { font-size: 26rpx; color: #8A6A12; }

.card-know {
  margin: 20rpx 0 6rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: linear-gradient(180deg, #C0392B 0%, #96291D 100%);
  color: #FFF6DC;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 0 #6E1D14, 0 10rpx 20rpx rgba(0, 0, 0, 0.25);
}

/* ============ 新手引导 ============ */
.guide-mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 34, 24, 0.6);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 44rpx 44rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.guide-step {
  font-size: 24rpx;
  color: #8A6A12;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.guide-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
}

.guide-text {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #6B6455;
  line-height: 1.7;
  min-height: 120rpx;
}

.guide-btn {
  margin-top: 30rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

/* ============ 通关情绪反馈（PRD 4.2） ============ */
/* 粒子层：金色莲花瓣 + 五色风马旗碎片，向上飘散旋转淡出 */
.fx-layer {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 60;
  pointer-events: none;
  overflow: hidden;
}
.fx-glow {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 78%,
    rgba(183, 149, 11, 0.42) 0%,
    rgba(183, 149, 11, 0.16) 34%,
    rgba(192, 57, 43, 0.10) 55%,
    rgba(0, 0, 0, 0) 76%);
  animation: fxGlow 1.5s ease-out both;
}
@keyframes fxGlow {
  0%   { opacity: 0; transform: scale(0.7); }
  28%  { opacity: 1; }
  100% { opacity: 0.35; transform: scale(1.06); }
}
.fx-bit {
  position: absolute;
  animation: fxPop 1.4s cubic-bezier(0.16, 0.72, 0.36, 1) both;
}
.fx-bit.alt {
  animation-name: fxPopAlt;
}
/* 莲花瓣：一端收尖的花瓣形 */
.fx-bit.lotus {
  border-radius: 50% 50% 50% 0;
  box-shadow: 0 0 12rpx rgba(183, 149, 11, 0.55);
}
/* 风马旗碎片：小方旗 */
.fx-bit.flag {
  border-radius: 4rpx;
}
@keyframes fxPop {
  0%   { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.5); }
  10%  { opacity: 1; transform: translate(0, -30rpx) rotate(24deg) scale(1); }
  100% { opacity: 0; transform: translate(-90rpx, -420rpx) rotate(-260deg) scale(0.86); }
}
@keyframes fxPopAlt {
  0%   { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.5); }
  10%  { opacity: 1; transform: translate(0, -30rpx) rotate(-24deg) scale(1); }
  100% { opacity: 0; transform: translate(90rpx, -420rpx) rotate(260deg) scale(0.86); }
}

/* ====== D51 学习体系：长按放大预览 + 步数预算 ====== */
.status-steps {
  font-size: 24rpx;
  color: #EBD9B4;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(36, 113, 163, 0.22);
  border: 1rpx solid rgba(36, 113, 163, 0.45);
}
.status-steps.low { color: #FFF6DC; background: rgba(192, 57, 43, 0.5); border-color: rgba(192, 57, 43, 0.6); }
.zoom-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6, 14, 26, 0.72);
}
.zoom-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 400rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FDF6E3 0%, #F0E4C4 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.75);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.5);
}
.zoom-glyph {
  font-size: 200rpx;
  line-height: 1.1;
  font-weight: 700;
}
.zoom-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #6B6455;
}

/* ---- D62 连击光晕（四档强度递增，一闪即收）----
   刻意不加 pointer-events 阻断：它是纯装饰，且 D57 刚把打扰降到每局 2 次，
   这里不能再引入「挡住牌面」的新问题。 */
.combo-aura {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 640rpx;
  height: 640rpx;
  margin-left: -320rpx;
  margin-top: -320rpx;
  border-radius: 50%;
  pointer-events: none;
  z-index: 8;
  animation: comboAura 420ms ease-out forwards;
}
.combo-aura.lv1 { background: radial-gradient(circle, rgba(255, 214, 120, 0.16) 0%, rgba(255, 214, 120, 0) 68%); }
.combo-aura.lv2 { background: radial-gradient(circle, rgba(255, 186, 90, 0.24) 0%, rgba(255, 186, 90, 0) 68%); }
.combo-aura.lv3 { background: radial-gradient(circle, rgba(233, 120, 60, 0.32) 0%, rgba(233, 120, 60, 0) 66%); }
.combo-aura.lv4 {
  background: radial-gradient(circle, rgba(255, 236, 180, 0.46) 0%, rgba(214, 120, 40, 0.16) 42%, rgba(214, 120, 40, 0) 70%);
  width: 780rpx; height: 780rpx; margin-left: -390rpx; margin-top: -390rpx;
}
@keyframes comboAura {
  0%   { opacity: 0; transform: scale(0.72); }
  22%  { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.16); }
}
