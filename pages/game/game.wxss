/* pages/game/game.wxss */
.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
  position: relative;
}

/* ============ 藏文化背景层 ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.85;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.92;
}

/* 页面背景：暖米色渐变，与背景层配合 */
.page {
  background: linear-gradient(180deg, #FDF6E3 0%, #FAF0DA 52%, #F2E4C6 100%);
}

.statusbar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 22rpx;
  margin-bottom: 14rpx;
  font-size: 29rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(228, 220, 200, 0.9);
  border-radius: 18rpx;
}

.status-level {
  font-weight: 700;
  color: #C0392B;
}

.status-pairs {
  color: #8A8375;
}

.status-score {
  color: #B7950B;
  font-weight: 700;
}

/* ============ 盘面：纸面面板（前后景视觉分层的关键） ============ */
.game-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 560rpx;
}

.board-panel {
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 26rpx;
  padding: 14rpx;
  box-shadow: 0 12rpx 36rpx rgba(96, 78, 44, 0.16);
}

.board-outline {
  border: 2rpx dashed rgba(183, 149, 11, 0.4);
  border-radius: 18rpx;
  padding: 10rpx;
}

.board {
  display: grid;
  margin: 0 auto;
}

.tile {
  position: relative;
  background: #FFFFFF;
  border: 2rpx solid #E4DCC8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
}

.glyph {
  font-weight: 500;
  line-height: 1;
  transform: translateY(-4%);
}

.glyph-img {
  width: 72%;
  height: 72%;
}

.glyph-fallback {
  font-size: 30rpx !important;
  font-weight: 600;
}

/* 选中态 */
.tile.selected {
  transform: scale(1.08);
  border-width: 3rpx;
  box-shadow: 0 6rpx 16rpx rgba(62, 58, 51, 0.18);
  z-index: 2;
}

/* 消除动画：缩小到 0 + 淡出，200ms */
.tile.removing {
  transform: scale(0);
  opacity: 0;
}

/* 已消除 */
.tile.removed {
  visibility: hidden;
  pointer-events: none;
}

/* 不匹配抖动 */
.tile.shake {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-6rpx); }
}

/* 金色特殊方块：暖底 + 金边 + 角标 */
.tile.golden {
  background: linear-gradient(160deg, #FFF9E6, #FFEFC2);
  border-color: #D4AC0D;
  box-shadow: 0 2rpx 10rpx rgba(212, 172, 13, 0.35);
}

.gold-star {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  font-size: 20rpx;
  color: #D4AC0D;
  line-height: 1;
}

/* 连击浮层 */
.combo-fx {
  position: fixed;
  top: 220rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(192, 57, 43, 0.92);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  padding: 14rpx 44rpx;
  border-radius: 40rpx;
  z-index: 9;
  animation: comboPop 1.4s ease forwards;
  pointer-events: none;
}

@keyframes comboPop {
  0%   { opacity: 0; transform: translateX(-50%) scale(0.6); }
  18%  { opacity: 1; transform: translateX(-50%) scale(1.12); }
  30%  { transform: translateX(-50%) scale(1); }
  80%  { opacity: 1; }
  100% { opacity: 0; transform: translateX(-50%) translateY(-24rpx); }
}

/* ============ 重复匹配轻提示（非阻塞） ============ */
.toast {
  position: fixed;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%) translateY(20rpx);
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(44, 62, 80, 0.92);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 12rpx 26rpx 12rpx 14rpx;
  font-size: 26rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease, transform 0.22s ease;
  z-index: 55;
  max-width: 86%;
  box-sizing: border-box;
}
.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.toast-glyph {
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  overflow: hidden;
}
.toast-glyph text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1;
}
.toast-icon {
  width: 34rpx;
  height: 34rpx;
}

/* ============ 文化卡（首次发现，非阻塞 + 自动收起） ============ */
.card-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  z-index: 50;
  overflow: hidden;
  box-shadow: 0 -12rpx 40rpx rgba(60, 44, 16, 0.28);
}

.card-sheet.show {
  transform: translateY(0);
}

.card-hero {
  position: relative;
  padding: 26rpx 30rpx 22rpx;
  color: #FFFFFF;
  overflow: hidden;
}

/* 头图藏纹水印 */
.hero-pat {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('/images/pat-tile.png');
  background-size: 76rpx 76rpx;
  opacity: 0.2;
}

.card-hero > view { position: relative; }

.card-x {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 26rpx;
}

.card-orn-l, .card-orn-r {
  position: absolute;
  top: 30rpx;
  font-size: 26rpx;
  opacity: 0.75;
  color: #FFE9B8;
}
.card-orn-l { left: 26rpx; }
.card-orn-r { right: 88rpx; }

.card-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.card-medal {
  width: 112rpx;
  height: 112rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
  flex: 0 0 auto;
  overflow: hidden;
}

.card-medal-g {
  font-size: 66rpx;
  line-height: 1;
}

.card-medal-img {
  width: 74%;
  height: 74%;
}

.card-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.94;
}

.card-body {
  padding: 24rpx 30rpx 6rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #3D3A30;
  line-height: 1.72;
}

.card-fact {
  margin-top: 20rpx;
  background: #FBF4E2;
  border-left: 6rpx solid #B7950B;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
}

.fact-label {
  display: inline-block;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #B7950B;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-bottom: 10rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.fact-text {
  display: block;
  font-size: 26rpx;
  color: #5B5343;
  line-height: 1.7;
}

/* 倒计时进度条 */
.card-progress {
  height: 6rpx;
  background: rgba(0, 0, 0, 0.07);
  margin-top: 20rpx;
}

.card-bar {
  height: 100%;
  width: 100%;
}
.card-bar.run {
  animation: cardBar 5200ms linear forwards;
}
@keyframes cardBar {
  from { width: 100%; }
  to   { width: 0%; }
}

.card-hint {
  text-align: center;
  font-size: 20rpx;
  color: #B3AB99;
  padding: 12rpx 0 16rpx;
}

/* ============ 新手引导 ============ */
.guide-mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 34, 24, 0.6);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 44rpx 44rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.guide-step {
  font-size: 24rpx;
  color: #B7950B;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.guide-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
}

.guide-text {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #6B6455;
  line-height: 1.7;
  min-height: 120rpx;
}

.guide-btn {
  margin-top: 30rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
