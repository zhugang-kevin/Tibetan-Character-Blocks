<view class="page">

  <!-- 藏文化背景层（六层：全局底图 / 纹样 / 藏纸颗粒 / 雪山布达拉宫 / 经幡 / 夜色罩） -->
  <view class="scenery" aria-hidden="true">
    <image class="sc-bg" src="/images/bg-global.jpg" mode="aspectFill" />
    <!-- 真实场景照片层（清单驱动；空 = 不渲染） -->
    <image wx:if="{{scenePhoto}}" class="sc-photo" src="{{scenePhoto}}" mode="aspectFill" />
    <view class="sc-pattern"></view>
    <view class="grain"></view>
    <image class="sc-ground" src="/images/bg-ground.png" mode="widthFix" />
    <image class="sc-sky" src="/images/bg-sky.png" mode="widthFix" />
    <view class="sc-night"></view>
  </view>

  <!-- 顶部状态条 -->
  <view class="statusbar">
    <text class="status-level">{{learnName ? ('L' + learnLv + ' · ' + learnStage + ' 课') : ('第 ' + level + ' 课')}}</text>
    <text class="status-score">学习得分 {{score}}</text>
    <text class="status-pairs">{{matchedPairs}}/{{totalPairs}} 对</text>
    <!-- D51 学习体系：步数预算（每关限量尝试，用完即结算；与「正确率」分开统计） -->
    <text wx:if="{{stepsBudget}}" class="status-steps {{stepsLeft <= 3 ? 'low' : ''}}">剩余 {{stepsLeft}}/{{stepsBudget}} 步</text>
    <!-- 文案开关（D34）：只关赞美文案，不关元素发音（发音属学习闭环） -->
    <text class="status-praise {{praiseOff ? 'off' : ''}}" bindtap="onTogglePraise">{{praiseOff ? '文案 关' : '文案 开'}}</text>
    <!-- 背景音乐开关（PRD 3.3）：默认开，只关 BGM，不关音效与朗读 -->
    <text class="status-praise status-bgm {{bgmOff ? 'off' : ''}}" bindtap="onToggleBgm">{{bgmOff ? '音乐 关' : '音乐 开'}}</text>
  </view>

  <!-- 即时应激励浮字（D34）：一次只显示一条，**新的替换旧的**（不排队、不叠加）。
       ant-a / ant-b 是同一组动画的两个名字，轮流用：WXSS 里同一个 animation-name
       不会重播，替换文案时必须换名，否则第二条看不出在播放。 -->
  <view wx:if="{{praiseOn}}" class="praise-fx lv{{praiseLevel}} {{praiseAnt ? 'ant-a' : 'ant-b'}}">
    <text wx:if="{{praiseLevel >= 2}}" class="praise-combo">连续正确 ×{{praiseCombo}}</text>
    <text wx:if="{{praiseTibetan}}" class="praise-bo tibetan">{{praiseBo}}</text>
    <text class="praise-zh">{{praiseZh}}</text>
  </view>
  <!-- 档位跃迁（等级 4 起）的一次性光环：挂在 praiseAnt 上，靠重新挂载让动画重播 -->
  <view wx:if="{{praiseOn && praiseBurst && praiseAnt}}" class="praise-burst"></view>

  <!-- 破冰 / 破箱浮字 -->
  <view wx:if="{{brokenFx}}" class="break-fx">{{brokenFx}}</view>

  <!-- 盘面：第二层「青金石蓝底盘」+ 第三层「凹陷槽位」+ 第四层「3D 凸起方块」 -->
  <view class="game-body">
    <view class="board-panel">
      <view class="board-outline">
        <!-- 秘境揭图（D31）：垫在牌层之下，某格被清空过就永久透出，完成后整幅揭晓 -->
        <view class="board-wrap" style="width: {{boardW}}rpx; height: {{boardH}}rpx;">
          <image wx:if="{{reveal.img}}" class="reveal-img" src="{{reveal.img}}" mode="scaleToFill" aria-hidden="true" />
          <!-- D33 下落式盘面：方块绝对定位（按 uid 稳定 key），坐标用百分比表达；
               消除后上方方块下落 = 同一个节点换坐标，由 CSS transition 平滑过渡；
               补充牌首帧停在盘外上方且透明（.fresh），下一帧落到位置，于是「从顶上掉下来」。 -->
          <view class="board" style="width: {{boardW}}rpx; height: {{boardH}}rpx;">
            <view
              wx:for="{{pieces}}"
              wx:key="uid"
              class="tile {{item.state}} {{item.blocked ? 'blocked' : ''}} {{item.fresh ? 'fresh' : ''}}"
              style="width: {{tileW}}rpx; height: {{tileH}}rpx; transform: translate({{item.tx}}%, {{item.ty}}%);"
              data-index="{{item.index}}"
              bindtap="onTapTile"
              bindlongpress="onTileLongPress"
            >
              <!-- 第四层：凸起方块（渐变底色 + 底部投影 + 顶部高光；精灵表字母用帧图取代渐变） -->
              <view class="piece {{item.sprite ? 'ka-sprite-piece' : ''}}" style="{{item.pieceStyle}}">
                <view wx:if="{{item.sprite}}" class="ka-sprite ka-v{{item.variant}}">
                  <image src="{{item.spriteSrc}}" mode="scaleToFill" />
                </view>
                <text wx:elif="{{item.type === 'letter'}}" class="glyph tibetan" style="font-size: {{item.glyphOverride || glyphSize}}rpx;">{{item.tibetan}}</text>
                <image wx:elif="{{iconPaths[item.id + '|lite']}}" class="glyph-img" src="{{item.golden ? iconPaths[item.id + '|gold'] : iconPaths[item.id + '|lite']}}" mode="aspectFit" />
                <text wx:else class="glyph-fallback">{{item.fallbackText}}</text>
                <view wx:if="{{item.golden}}" class="gold-star">✦</view>
                <!-- 破碎粒子：金粉 / 风马旗碎片（消除瞬间播放） -->
                <view wx:if="{{item.shatter}}" class="bits">
                  <view wx:for="{{bitSlots}}" wx:for-item="b" wx:key="*this" class="bit {{b}}"></view>
                </view>
              </view>
              <!-- 障碍物：冰霜（半透明蓝罩 + 白边高光）——遮挡跟随方块下落（D33） -->
              <view wx:if="{{item.frost}}" class="frost"><text class="frost-mark">❄</text></view>
              <!-- 障碍物：绳结（双股绳十字缠裹 + 剩余股数，D40 世俗皮肤，来历见 docs/DECISIONS.md） -->
              <view wx:if="{{item.rope > 0}}" class="rope"><text class="rope-num">{{item.rope}}</text></view>
              <!-- 障碍物：藏式木箱（木纹 + 金色剩余耐久） -->
              <view wx:if="{{item.crate > 0}}" class="crate"><text class="crate-num">{{item.crate}}</text></view>
            </view>
          </view>
        </view>
      </view>
      <!-- 揭图进度：只报百分比，不剧透名字（名字在通关揭晓时才出现） -->
      <view wx:if="{{reveal.img}}" class="reveal-cap">秘境图 · 已揭开 {{revealPct}}%</view>
    </view>
  </view>

  <!-- 重复匹配轻提示（非阻塞） -->
  <view class="toast {{toastShow ? 'show' : ''}}">
    <view class="toast-glyph" style="background: {{toastColor}};">
      <image wx:if="{{toastIsIcon}}" class="toast-icon" src="{{toastIcon}}" mode="aspectFit" />
      <text wx:else class="tibetan">{{toastGlyph}}</text>
    </view>
    <text>{{toastText}}</text>
  </view>

  <!-- 文化卡（首次发现滑出 · 藏纸卷轴样式 · 不打断游戏） -->
  <view class="card-sheet {{showCard ? 'show' : ''}}" wx:if="{{card}}" bindtouchstart="holdCard">
    <view class="scroll-rod"></view>
    <view class="card-hero" style="background: linear-gradient(135deg, {{cardColor}}, {{cardColorDark}});">
      <view class="hero-pat"></view>
      <view class="card-x" bindtap="dismissCard">✕</view>
      <view class="card-orn-l">✦</view>
      <view class="card-orn-r">✦</view>
      <view class="card-row">
        <view class="card-medal">
          <text wx:if="{{card.tibetan}}" class="card-medal-g tibetan" style="color: {{cardColor}};">{{card.tibetan}}</text>
          <image wx:elif="{{iconPaths[card.id]}}" class="card-medal-img" src="{{iconPaths[card.id]}}" mode="aspectFit" />
          <text wx:else class="card-medal-g" style="color: {{cardColor}};">{{card.title}}</text>
        </view>
        <view class="card-head-txt">
          <view class="card-title">{{card.title}}</view>
          <view class="card-subtitle">{{card.subtitle}}</view>
        </view>
      </view>
    </view>
    <view class="card-body">
      <view class="card-desc">{{card.description}}</view>
      <view class="card-fact">
        <text class="fact-label">文化小知识</text>
        <text class="fact-text">{{card.funFact}}</text>
      </view>
      <!-- 喇叭：点击播放本元素的藏文发音 -->
      <view class="card-speak" bindtap="speakCard">
        <text class="speak-icon">🔊</text>
        <text class="speak-text">点击播放藏文读音</text>
      </view>
      <view class="card-know" bindtap="dismissCard">知道了</view>
    </view>
    <view class="card-progress">
      <view class="card-bar {{cardBarRun ? 'run' : ''}}" style="background: {{cardColor}};"></view>
    </view>
    <view class="card-hint">游戏不会暂停 · 点「知道了」或继续消除即可收起</view>
  </view>

  <!-- 通关情绪反馈：金色莲花 + 风马旗碎片粒子 + 雪山金光（纯 CSS，零依赖） -->
  <view wx:if="{{fxOn}}" class="fx-layer" aria-hidden="true">
    <view class="fx-glow"></view>
    <view
      wx:for="{{fx}}"
      wx:key="index"
      class="fx-bit {{item.kind}}{{item.alt}}"
      style="left:{{item.left}};top:{{item.top}};width:{{item.size}};height:{{item.size}};background:{{item.color}};animation-delay:{{item.delay}}ms;"
    ></view>
  </view>

  <!-- D51 长按放大预览：L11 以上（zoomable）的复合音节看得更清楚，点任意处收起 -->
  <view wx:if="{{zoom.show}}" class="zoom-mask" bindtap="closeZoom">
    <view class="zoom-box">
      <text class="zoom-glyph tibetan" style="color: {{zoom.color}};">{{zoom.tibetan}}</text>
      <view class="zoom-tip">松开手，继续配对</view>
    </view>
  </view>

  <!-- 新手引导（首次进入，3 步） -->
  <view wx:if="{{guideStep}}" class="guide-mask">
    <view class="guide-card">
      <view class="guide-step">{{guideStep}} / 3</view>
      <view class="guide-title">{{guide.title}}</view>
      <view class="guide-text">{{guide.text}}</view>
      <button class="guide-btn" bindtap="guideNext">{{guideStep === 3 ? '开始学习' : '下一步'}}</button>
    </view>
  </view>

</view>
