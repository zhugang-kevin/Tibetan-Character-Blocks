/* pages/shop/shop.wxss — 藏香商城页（D132）
   字号下限 26rpx（D66 门禁）；背景纯 CSS，不引用任何实景图（88 号文 第 2 条）。 */

.page {
  position: relative;
  min-height: 100vh;
  background: #FDF6E3;
  overflow-x: hidden;
}

/* ---------- 背景层：纯 CSS，无实景、无宗教符号 ---------- */
.scenery {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 520rpx;
  overflow: hidden;
  pointer-events: none;
}
.sp-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(45deg, rgba(192,57,43,0.05) 0 12rpx, transparent 12rpx 24rpx);
}
.sp-grain {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url("/images/grain.png");
  background-repeat: repeat;
  opacity: 0.06;
}
.sp-night {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, #7A1F16 0%, #C0392B 45%, rgba(253,246,227,0) 100%);
}

/* ---------- 内容 ---------- */
.content {
  position: relative;
  z-index: 2;
  padding: 48rpx 32rpx 64rpx;
}

.sp-hero { padding: 24rpx 8rpx 40rpx; }
.sp-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 6rpx;
}
.sp-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #F6D9C9;
  letter-spacing: 2rpx;
}

/* ---------- 商品卡 ---------- */
.sp-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(122, 31, 22, 0.14);
}

.sp-card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.sp-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #3B2A22;
}
.sp-price {
  font-size: 48rpx;
  font-weight: 700;
  color: #C0392B;
}
.sp-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #9A8578;
}

.sp-spec {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #7A6558;
}

.sp-rows {
  margin-top: 28rpx;
  border-top: 2rpx solid #F0E4D6;
  padding-top: 20rpx;
}
.sp-row {
  display: flex;
  padding: 10rpx 0;
}
.sp-k {
  width: 120rpx;
  flex: none;
  font-size: 26rpx;
  color: #9A8578;
}
.sp-v {
  flex: 1;
  font-size: 26rpx;
  color: #3B2A22;
  line-height: 1.5;
}

.sp-tags {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}
.sp-tag {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 18rpx;
  font-size: 26rpx;
  color: #7A1F16;
  background: #FBEEE7;
  border: 2rpx solid #EBD3C6;
  border-radius: 999rpx;
}

.sp-stock {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9A8578;
}

.sp-buy {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #C0392B;
  border-radius: 999rpx;
}
.sp-buy.off {
  background: #C9BCB2;
  color: #6E5F55;
}

.sp-foot {
  margin-top: 40rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #9A8578;
}

/* 帮助与客服入口（D167） */
.sp-svc {
  display: block; margin-top: 24rpx; padding: 26rpx 28rpx;
  background: rgba(246, 220, 160, .12); border: 1rpx solid rgba(246, 220, 160, .38);
  border-radius: 16rpx;
}
.sp-svc-t { display: block; font-size: 28rpx; font-weight: 700; color: #F6DCA0; }
.sp-svc-s { display: block; margin-top: 6rpx; font-size: 26rpx; color: #E7B98A; }
