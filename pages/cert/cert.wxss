/* pages/cert/cert.wxss — 藏文成长证书 */
.page {
  min-height: 100vh;
  padding: 40rpx 36rpx 80rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #FDF6E3 0%, #FAF0DA 52%, #F2E4C6 100%);
  color: #2C3E50;
}

/* ============ 藏文化背景层（与首页/游戏页/结算页统一） ============ */
.scenery {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.sc-pattern {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image: url('data:image/png;base64,');
  background-repeat: repeat;
  background-size: 60rpx 60rpx;
  opacity: 0.10;
}
.sc-ground {
  position: absolute;
  left: 0; bottom: 0; width: 100%;
  opacity: 0.88;
}
.sc-sky {
  position: absolute;
  left: 0; top: 0; width: 100%;
  opacity: 0.95;
}

.content {
  position: relative;
  z-index: 1;
}

/* ============ 证书纸张 ============ */
.sheet {
  background: linear-gradient(180deg, #FFFDF6 0%, #FDF6E3 100%);
  border: 6rpx solid #C0392B;
  border-radius: 28rpx;
  padding: 10rpx;
  box-shadow: 0 14rpx 40rpx rgba(96, 78, 44, 0.22);
  margin-bottom: 30rpx;
}

.sheet-inner {
  border: 2rpx solid rgba(183, 149, 11, 0.55);
  border-radius: 20rpx;
  padding: 34rpx 30rpx 26rpx;
  position: relative;
  text-align: center;
}

.sheet-orn-l,
.sheet-orn-r {
  position: absolute;
  top: 18rpx;
  color: rgba(192, 57, 43, 0.65);
  font-size: 26rpx;
}

.sheet-orn-l { left: 20rpx; }
.sheet-orn-r { right: 20rpx; }

.sheet-tib {
  font-size: 40rpx;
  color: rgba(192, 57, 43, 0.78);
  letter-spacing: 2rpx;
}

.sheet-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #2C3E50;
}

.sheet-rule {
  width: 300rpx;
  height: 2rpx;
  margin: 20rpx auto 24rpx;
  background: linear-gradient(90deg, rgba(183, 149, 11, 0) 0%, rgba(183, 149, 11, 0.8) 50%, rgba(183, 149, 11, 0) 100%);
}

.sheet-stage {
  font-size: 26rpx;
  color: #8A8375;
  letter-spacing: 4rpx;
}

.sheet-name {
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.sheet-tier {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 34rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sheet-lines {
  margin: 34rpx 0 8rpx;
}

.sheet-line {
  font-size: 28rpx;
  color: #2C3E50;
  line-height: 1.9;
}

.sheet-meta {
  margin-top: 24rpx;
  text-align: left;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 4rpx;
  border-bottom: 2rpx dashed rgba(214, 202, 176, 0.95);
}

.meta-k {
  font-size: 24rpx;
  color: #8A8375;
  flex-shrink: 0;
}

.meta-v {
  font-size: 26rpx;
  color: #2C3E50;
  font-weight: 600;
  text-align: right;
}

.meta-edit {
  font-size: 22rpx;
  color: #C0392B;
}

.sheet-foot {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
}

.foot-code {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border: 2rpx solid rgba(183, 149, 11, 0.6);
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #C0392B;
  background: rgba(255, 255, 255, 0.9);
}

.sheet-slogan {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #B7950B;
  letter-spacing: 4rpx;
}

/* ============ 操作区 ============ */
.primary-btn {
  background: #C0392B;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
}

.cert-img {
  width: 100%;
  margin-top: 26rpx;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(96, 78, 44, 0.22);
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.half-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #C0392B;
  color: #FFFFFF;
  padding: 0;
}

.half-btn.ghost {
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

.share-btn {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  background: #1E8449;
  color: #FFFFFF;
}

.cert-tip {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #8A8375;
  text-align: center;
  line-height: 1.7;
}

/* ============ 未获得状态 ============ */
.locked-box {
  background: rgba(255, 255, 255, 0.9);
  border: 3rpx dashed #D6CAB0;
  border-radius: 24rpx;
  padding: 50rpx 34rpx;
  text-align: center;
  margin-bottom: 26rpx;
}

.locked-icon {
  font-size: 68rpx;
}

.locked-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
}

.locked-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8A8375;
}

.locked-progress {
  margin-top: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #C0392B;
}

.locked-rule {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #6B6455;
  line-height: 1.7;
}

.tier-box {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(214, 202, 176, 0.95);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 26rpx;
}

.tier-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6B6455;
  margin-bottom: 16rpx;
}

.tier-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.tier-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tier-name {
  margin-left: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  width: 150rpx;
  flex-shrink: 0;
}

.tier-rule {
  font-size: 22rpx;
  color: #8A8375;
  line-height: 1.5;
}

/* ============ 底部按钮 ============ */
.passport-btn {
  margin-top: 6rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #1E8449;
  border: 2rpx solid #1E8449;
  box-sizing: border-box;
}

.home-btn {
  margin-top: 14rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  background: #FFFFFF;
  color: #C0392B;
  border: 2rpx solid #C0392B;
  box-sizing: border-box;
}

/* ============ 弹窗 ============ */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 34, 24, 0.5);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
}

.modal-sub {
  text-align: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8375;
  line-height: 1.6;
}

.name-input {
  margin-top: 30rpx;
  height: 88rpx;
  border: 2rpx solid #E4DCC8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.name-placeholder {
  color: #B9B1A0;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
}

.modal-btn.ghost {
  background: #F3EFE3;
  color: #6B6455;
}

.modal-btn.solid {
  background: #C0392B;
  color: #FFFFFF;
}
