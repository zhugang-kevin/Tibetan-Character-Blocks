<view class="page">

  <!-- 藏文化背景层（与首页/游戏页/结算页统一） -->
  <view class="scenery" aria-hidden="true">
    <image class="sc-bg" src="/images/bg-global.jpg" mode="aspectFill" />
    <view class="sc-pattern"></view>
    <image class="sc-ground" src="/images/bg-ground.png" mode="widthFix" />
    <image class="sc-sky" src="/images/bg-sky.png" mode="widthFix" />
    <view class="sc-night"></view>
  </view>

  <view class="content">

    <!-- ============ 已获得证书 ============ -->
    <block wx:if="{{cert}}">
      <view class="sheet" style="border-color: {{cert.tierColor}};">
        <view class="sheet-inner">
          <view class="sheet-orn-l">✦</view>
          <view class="sheet-orn-r">✦</view>

          <view class="sheet-tib tibetan">བོད་ཡིག་སློབ་སྦྱོང</view>
          <view class="sheet-title">藏文成长证书</view>
          <view class="sheet-rule"></view>

          <view class="sheet-stage">第 {{cert.stage}} 阶段</view>
          <view class="sheet-name" style="color: {{cert.tierColor}};">{{cert.stageName}}</view>
          <view class="sheet-tier" style="background: {{cert.tierColor}};">{{cert.tierLabel}}</view>

          <view class="sheet-lines">
            <view wx:for="{{cert.lines}}" wx:key="*this" class="sheet-line">✦  {{item}}</view>
          </view>

          <view class="sheet-meta">
            <view class="meta-row">
              <text class="meta-k">证书编号</text>
              <text class="meta-v">{{cert.no}}</text>
            </view>
            <view class="meta-row" bindtap="openNameModal">
              <text class="meta-k">持 有 人</text>
              <text class="meta-v">{{cert.holder}} <text class="meta-edit">✎</text></text>
            </view>
            <view class="meta-row">
              <text class="meta-k">颁发日期</text>
              <text class="meta-v">{{cert.date}}</text>
            </view>
            <view class="meta-row">
              <text class="meta-k">学习表现</text>
              <text class="meta-v">正确率 {{cert.acc}}%{{cert.clean ? ' · 零失误' : ''}}</text>
            </view>
          </view>

          <view class="sheet-foot">
            <image class="foot-logo" src="/images/logo-80.png" mode="aspectFit" />
            <view class="foot-code">小程序码</view>
          </view>
          <view class="sheet-slogan">玩方块，认藏文</view>
        </view>
      </view>

      <button class="primary-btn" bindtap="generate" disabled="{{generating}}">
        {{generating ? '生成中…' : '生成证书图片'}}
      </button>

      <block wx:if="{{imagePath}}">
        <image class="cert-img" src="{{imagePath}}" mode="widthFix" />
        <view class="btn-row">
          <button class="half-btn ghost" bindtap="previewShare">预览 / 长按转发</button>
          <button class="half-btn" bindtap="saveToAlbum">保存到相册</button>
        </view>
        <button class="share-btn" open-type="share">分享给朋友</button>
      </block>

      <view class="cert-tip">证书是学习证明，不是积分。正确率越高，等级越高：金质 &gt; 银质 &gt; 普通。</view>
    </block>

    <!-- ============ 尚未获得 ============ -->
    <block wx:else>
      <view class="locked-box">
        <view class="locked-icon">🔒</view>
        <view class="locked-title">第 {{stage}} 阶段 · {{stageInfo.name}}</view>
        <view class="locked-sub">{{stageInfo.goal}}</view>
        <view class="locked-progress">当前进度 {{progress}} / {{total}} 关</view>
        <view class="locked-rule">
          通关第 {{stageInfo.from}}-{{stageInfo.to}} 关，即可获得「{{stageInfo.name}}」证书
        </view>
      </view>

      <view class="tier-box">
        <view class="tier-title">证书等级（质量门槛）</view>
        <view wx:for="{{tiers}}" wx:key="key" class="tier-row">
          <view class="tier-dot" style="background: {{item.color}};"></view>
          <view class="tier-name" style="color: {{item.color}};">{{item.label}}</view>
          <view class="tier-rule">{{item.rule}}</view>
        </view>
      </view>
    </block>

    <button class="passport-btn" bindtap="goPassport">查看文化护照</button>
    <button class="home-btn" bindtap="goHome">返回首页</button>

  </view>

  <!-- 持有人输入弹窗 -->
  <view wx:if="{{showNameModal}}" class="mask" bindtap="closeNameModal">
    <view class="modal" catchtap="noop">
      <view class="modal-title">证书持有人</view>
      <view class="modal-sub">将印在证书上（最多 10 个字），与祝福卡昵称通用</view>
      <input
        class="name-input"
        value="{{nameInput}}"
        maxlength="10"
        placeholder="藏文学习者"
        placeholder-class="name-placeholder"
        focus
        bindinput="onNameInput"
      />
      <view class="modal-btns">
        <button class="modal-btn ghost" bindtap="closeNameModal">取消</button>
        <button class="modal-btn solid" bindtap="confirmName">确定</button>
      </view>
    </view>
  </view>

</view>
