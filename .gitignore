# 微信开发者工具 / 系统文件
node_modules/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# TTS 密钥配置（含鉴权信息，绝不入库）
scripts/tts-config.json

# 真实图片原材料（大图不入库；README 除外）
assets-src/*/
generated-images/
.workbuddy/icon-src/
.workbuddy/tmp/
__pycache__/

# 服务端运行时数据（D137）
#   pay.db 曾误入库：每次跑服务都产生变更 → 提交噪音；且订单表里可能有 openid/订单号，
#   属于**用户数据**，不该跟着代码走。目录保留（.gitkeep），库文件不入库。
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/*.jsonl

# 服务端环境变量（含 AppKey/AppSecret，绝不入库；模板见 server/.env.example）
server/.env

# 上传密钥（后台生成，等同密码，绝不入库）
private.*.key

# ─── 密钥与证书（2026-10-23 新增）───
# 真实密钥文件绝不入库；仓库里只保留 docs/deploy/env.example 模板
*.env
api.env
!*.env.example
*.key
*.pem
*.p12
*.pfx
# 身份证/执照等备案材料
docs/备案材料/
*-身份证*.jpg
*-营业执照*.jpg

# ─── 生成物（2026-11-09）───
# 截图 / 通关报告 / 抓图缓存 / 质量队列都是**跑出来的**，不是源码。
# 合计约 68MB，进库只会让 clone 变慢、diff 变噪音；需要时由脚本重新生成。
docs/screenshots/
docs/play-150/
.workbuddy/data/
.workbuddy/quality/

